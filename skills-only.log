│      28→        iter[Any]: batched iterable
│      29→    """
│      30→    if sys.version_info >= (3, 12):
│      31→        batch_f = itertools.batched
│      32→    else:
│      33→        # taken from https://docs.python.org/3/library/itertools.html#itertools.batched
│      34→        def batch_f(iterable: Iterable[Any], n: int) -> Iterable[Any]:
│      35→            # batched('ABCDEFG', 3) → ABC DEF G
│      36→            if n < 1:
│      37→                raise ValueError(ERR_BATCHED_N)
│      38→            it = iter(iterable)
│      39→            while batch := tuple(itertools.islice(it, n)):
│      40→                yield batch
│      41→
│      42→    return batch_f(iterable, n)
│      43→
│      44→
│      45→def _tree_map(fn, *trees):
│      46→    """Apply a function to corresponding leaves of nested structures (PyTree-like).
│      47→
│      48→    This is a MindSpore-compatible replacement for jax.tree.map.
│      49→    Supports dicts, lists, tuples, and Tensors.
│      50→    """
│      51→    if not trees:
│      52→        return None
│      53→
│      54→    first = trees[0]
│      55→
│      56→    # Base case: all elements are Tensors or scalars
│      57→    if isinstance(first, (Tensor, int, float, type(None))):
│      58→        return fn(*trees)
│      59→
│      60→    # Dict case
│      61→    if isinstance(first, dict):
│      62→        result = {}
│      63→        for key in first.keys():
│      64→            values = [t[key] for t in trees]
│      65→            result[key] = _tree_map(fn, *values)
│      66→        return result
│      67→
│      68→    # List case
│      69→    if isinstance(first, list):
│      70→        result = []
│      71→        for i in range(len(first)):
│      72→            values = [t[i] for t in trees]
│      73→            result.append(_tree_map(fn, *values))
│      74→        return result
│      75→
│      76→    # Tuple case
│      77→    if isinstance(first, tuple):
│      78→        result = []
│      79→        for i in range(len(first)):
│      80→            values = [t[i] for t in trees]
│      81→            result.append(_tree_map(fn, *values))
│      82→        return tuple(result)
│      83→
│      84→    # Fallback: apply function directly
│      85→    return fn(*trees)
│      86→
│      87→
│      88→def tree_stack(trees: list[typ.PyTree]) -> typ.PyTree:
│      89→    """Stacks corresponding leaves of PyTrees into arrays along a new axis."""
│      90→    return _tree_map(lambda *v: mnp.stack(v), *trees)
│      91→
│      92→
│      93→def tree_concatenate(trees: list[typ.PyTree]) -> typ.PyTree:
│      94→    """Concatenates corresponding leaves of PyTrees along the first axis."""
│      95→    return _tree_map(lambda *v: mnp.concatenate(v), *trees)
│      96→
