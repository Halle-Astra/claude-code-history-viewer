│     229→def _parse_value_in(value: str) -> int | float | str:
│     230→    for t in (int, float):
│     231→        try:
│     232→            if t is float:
│     233→                tmp_value = value.replace("f", "").lower()
│     234→                parsed = float(sympy.parse_expr(tmp_value).evalf(n=SYMPY_EVAL_N))
│     235→            else:
│     236→                parsed = t(value)
│     237→        except (AttributeError, ValueError, SyntaxError, TypeError):
│     238→            continue
│     239→        else:
│     240→            return parsed
│     241→
│     242→    return value
│     243→
│     244→
│     245→def _parse_value_out(value: int | float | str) -> str:  # noqa: PYI041 -- this is documentation specific
│     246→    if isinstance(value, int) or (isinstance(value, jax.Array) and (jnp.issubdtype(value.dtype, jnp.integer))):
│     247→        parsed_value = str(value)
│     248→    elif isinstance(value, float) or (isinstance(value, jax.Array) and (jnp.issubdtype(value.dtype, jnp.floating))):
│     249→        parsed_value = f"{value}f"
│     250→    elif isinstance(value, str):
│     251→        parsed_value = value
│     252→    else:
│     253→        raise TypeError(ERR_INVALID_HEADER_TYPE.format(type(value), value))
│     254→    return parsed_value
│     255→
│     256→
│     257→def read_src_h(src_h: Path) -> dict[str, int | float | str]:
│     258→    """Parse the src/model.h file to get the parameters."""
│     259→    params = {}
│     260→    with src_h.open("r") as f:
│     261→        for line in f:
│     262→            # this is a variable
│     263→            if line.startswith("#define") and "MODEL_H_" not in line:
│     264→                # We need to parse lines of the following varieties:
│     265→                # #define POS_BACK -0.4f
│     266→                # #define HYDR_F1 0
│     267→                # #define HYDR_THETA8_T0 (PI*0.5f)
│     268→                # #define HYDR_T3_MESH_POINTS HYDR_T2_MESH_POINTS
│     269→                # #define CXST_T5_MESH_POINTS 6   // perfetto
│     270→
│     271→                parts = line.split()
│     272→                if (
│     273→                    len(parts) >= MIN_VALID_HEADER_TOKEN_COUNT
│     274→                    and (var_value := _parse_value_in(" ".join(parts[2:]).split("//")[0].strip())) is not None
│     275→                ):
│     276→                    params[parts[1]] = var_value
│     277→                else:
│     278→                    raise ValueError(ERR_CANNOT_PROCESS_SRC_H.format(line))
│     279→
│     280→    return params
│     281→
│     282→
│     283→def write_src_h(src_h: Path, params: dict[str, tuple[oxDNAModelHType, int | float | str]]) -> None:
│     284→    """Write the src/model.h file with the new parameters."""
│     285→    with src_h.open("w") as f:
│     286→        f.write(
│     287→            "\n".join(
│     288→                [
│     289→                    "/**",
│     290→                    " * @file model.h",
│     291→                    f" * @date {datetime.datetime.now(tz=datetime.UTC).strftime('%b %d, %Y')}",
│     292→                    " * @author fromano -- modified by jax_dna",
│     293→                    " */",
│     294→                    "",
│     295→                    "#ifndef MODEL_H_",
│     296→                    "#define MODEL_H_\n",
│     297→                ]
│     298→            )
│     299→        )
│     300→
│     301→        for key, value in params.items():
│     302→            try:
│     303→                parsed_value = _parse_value_out(value)
│     304→            except ValueError as e:
│     305→                raise ValueError(ERR_INVALID_HEADER_TYPE.format(key, value)) from e
│     306→
│     307→            f.write(f"#define {key} {parsed_value}\n")
│     308→            if key == "FENE_DELTA":
│     309→                f.write(f"#define FENE_DELTA2 {value**2}f\n")
│     310→
│     311→        f.write("#endif /* MODEL_H_ */\n")
