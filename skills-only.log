     def _tree_leaves(tree: Any) -> list[Any]:
         """Get all leaf values from a nested structure (dict, list, tuple)."""
         leaves = []
         if isinstance(tree, dict):
             for v in tree.values():
                 leaves.extend(_tree_leaves(v))
         elif isinstance(tree, (list, tuple)):
             for v in tree:
                 leaves.extend(_tree_leaves(v))
         else:
             leaves.append(tree)
         return leaves

     def _tree_map(func: Any, tree: Any, is_leaf: Any = None) -> Any:
         """Apply a function to all leaves of a nested structure."""
         if is_leaf is not None and is_leaf(tree):
             return func(tree)
         elif isinstance(tree, dict):
             return {k: _tree_map(func, v, is_leaf) for k, v in tree.items()}
         # ...
     ```

