│     225→    torque_twists: Tensor,
│     226→) -> tuple[float, float, float]:
│     227→    """Computes the effective stretch and torsion moduli, and twist-stretch coupling from stretch-torsion experiments.
│     228→
│     229→    Args:
│     230→        forces (Tensor): the forces applied to the polymer
│     231→        force_extensions (Tensor): the equilibrium extensions under the applied forces
│     232→        torques (Tensor): the torques applied to the polymer
│     233→        torque_extensions (Tensor): the equilibrium extensions under the applied torques
│     234→        torque_twists (Tensor): the equilibrium twists under the applied torques
│     235→
│     236→    Returns:
│     237→        Tuple[float, float, float]: the effective stretch modulus, torsional modulus, and twist-stretch coupling
│     238→    """
│     239→    # Compute the effective stretch modulus and relevant summary statistics from stretching experiments
│     240→    a1, l0, s_eff = stretch(forces, force_extensions)
│     241→
