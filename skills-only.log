│      12→@chex.dataclass(frozen=True)
│      13→class Stacking(jd_energy1.Stacking):
│      14→    """Stacking energy function for DNA2 model."""
│      15→
│      16→    params: jd_energy1.StackingConfiguration
│      17→
│      18→    def pairwise_energies(
│      19→        self,
│      20→        body: dna2_nucleotide.Nucleotide,
│      21→        seq: typ.Discrete_Sequence,
│      22→        bonded_neighbors: typ.Arr_Bonded_Neighbors_2,
