│     272→def read_src_h(src_h: Path) -> dict[str, int | float | str]:
│     273→    """Parse the src/model.h file to get the parameters."""
│     274→    params = {}
│     275→    with src_h.open("r") as f:
│     276→        for line in f:
│     277→            # this is a variable
│     278→            if line.startswith("#define") and "MODEL_H_" not in line:
│     279→                # We need to parse lines of the following varieties:
│     280→                # #define POS_BACK -0.4f
│     281→                # #define HYDR_F1 0
│     282→                # #define HYDR_THETA8_T0 (PI*0.5f)
│     283→                # #define HYDR_T3_MESH_POINTS HYDR_T2_MESH_POINTS
│     284→                # #define CXST_T5_MESH_POINTS 6   // perfetto
│     285→
│     286→                parts = line.split()
│     287→                if (
│     288→                    len(parts) >= MIN_VALID_HEADER_TOKEN_COUNT
│     289→                    and (var_value := _parse_value_in(" ".join(parts[2:]).split("//")[0].strip())) is not None
│     290→                ):
│     291→                    params[parts[1]] = var_value
│     292→                else:
│     293→                    raise ValueError(ERR_CANNOT_PROCESS_SRC_H.format(line))
│     294→
│     295→    return params
│     296→
│     297→
│     298→def write_src_h(src_h: Path, params: dict[str, tuple[oxDNAModelHType, int | float | str]]) -> None:
│     299→    """Write the src/model.h file with the new parameters."""
│     300→    with src_h.open("w") as f:
│     301→        f.write(
│     302→            "\n".join(
│     303→                [
│     304→                    "/**",
│     305→                    " * @file model.h",
│     306→                    f" * @date {datetime.datetime.now(tz=datetime.UTC).strftime('%b %d, %Y')}",
│     307→                    " * @author fromano -- modified by jax_dna",
│     308→                    " */",
│     309→                    "",
│     310→                    "#ifndef MODEL_H_",
│     311→                    "#define MODEL_H_\n",
│     312→                ]
│     313→            )
│     314→        )
│     315→
│     316→        for key, value in params.items():
│     317→            try:
│     318→                parsed_value = _parse_value_out(value)
│     319→            except ValueError as e:
│     320→                raise ValueError(ERR_INVALID_HEADER_TYPE.format(key, value)) from e
│     321→
│     322→            f.write(f"#define {key} {parsed_value}\n")
│     323→            if key == "FENE_DELTA":
│     324→                f.write(f"#define FENE_DELTA2 {value**2}f\n")
│     325→
│     326→        f.write("#endif /* MODEL_H_ */\n")
│     327→
│     328→
│     329→def update_params(src_h: Path, new_params: list[jd_types.Params]) -> None:
