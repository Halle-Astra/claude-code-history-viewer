│     188→    n_unpaired = sc.n_unpaired
│     189→
│     190→    up_pseq = np.zeros((n_unpaired, jd_const.N_NT), dtype=np.float64)
│     191→    for up_idx, idx in enumerate(unpaired):
│     192→        nt = dseq[idx]
│     193→        up_pseq[up_idx][nt] = 1.0
│     194→
│     195→    # Second, generate base paired pseq
│     196→    bps = sc.bps
│     197→    n_bp = sc.n_bp
│     198→
│     199→    bp_pseq = np.zeros((n_bp, 4), dtype=np.float64)
│     200→    for bp_idx, (idx1, idx2) in enumerate(bps):
