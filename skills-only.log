│      28→        )
│      29→
│      30→        # Compute sequence-dependent weight for each bonded pair
│      31→        nn_i = bonded_neighbors[:, 0]
│      32→        nn_j = bonded_neighbors[:, 1]
│      33→        stack_weights = self.params.ss_stack_weights[seq[nn_i], seq[nn_j]]
│      34→
│      35→        return jnp.multiply(stack_weights, v_stack)
│      36→
│      37→    @override
