│     274→
│     275→    sequence = []
│     276→    strand_counts = []
│     277→    is_circular = []
│     278→    is_end = []
│     279→    nt_type = []
│     280→    for line in lines[1:]:
│     281→        nucleotides = line.strip().split()[0]
│     282→        sequence.append(nucleotides)
│     283→        strand_counts.append(len(nucleotides))
│     284→        strand_is_circular = "circular=true" in line
│     285→        is_circular.append(strand_is_circular)
│     286→
│     287→        strand_length = len(nucleotides)
│     288→        strand_is_end = [0 for _ in range(strand_length)]
│     289→        if not strand_is_circular:
│     290→            strand_is_end[0] = 1
