│      25→def persistence_length_fit(correlations: jnp.ndarray, l0_av: float) -> tuple[float, float]:
│      26→    """Computes the Lp given correlations in alignment decay and average distance between base pairs.
│      27→
│      28→    Lp obeys the following equality: `<l_n * l_0> = exp(-n<l_0> / Lp)`, where `<l_n * l_0>` represents the
│      29→    average correlation between adjacent base pairs (`l_0`) and base pairs separated by a distance of
│      30→    `n` base pairs (`l_n`). This relationship is linear in log space, `log(<l_n * l_0>) = -n<l_0> / Lp`.
│      31→    So, given the average correlations across distances and the average distance between adjacent base pairs,
│      32→    we compute Lp via a linear fit.
│      33→
│      34→    Args:
│      35→        correlations (jnp.ndarray): a (max_dist,) array containing the average correlation between
│      36→            base pairs separated by distances up to `max_dist`
│      37→        l0_av (jnp.ndarray): the average distance between adjacent base pairs
│      38→    """
│      39→    # Format the correlations for a linear fit
│      40→    y = jnp.log(correlations)
│      41→    x = jnp.arange(correlations.shape[0])
│      42→    x = jnp.stack([jnp.ones_like(x), x], axis=1)
│      43→
│      44→    # Fit a line
│      45→    fit_ = jnp.linalg.lstsq(x, y)
│      46→
│      47→    # Extract slope and offset, and compute Lp
│      48→    offset = fit_[0][0]
│      49→    slope = fit_[0][1]  # slope = -l0_av / Lp
│      50→    Lp = -l0_av / slope  # noqa: N806 -- This is a special variable name
│      51→
│      52→    return Lp, offset
│      53→
│      54→
│      55→def compute_l_vector(base_sites: jnp.ndarray, quartet: jnp.ndarray) -> tuple[jnp.ndarray, float]:
│      56→    """Computes the distance between two adjacent base pairs."""
│      57→    # Extract the two base pairs defined by a quartet
│      58→    bp1, bp2 = quartet
│      59→    (a1, b1), (a2, b2) = bp1, bp2  # a1 and b1, and a2 and b2 are base paired
│      60→
│      61→    # Compute midpoints for each base pair
│      62→    mp1 = (base_sites[b1] + base_sites[a1]) / 2.0
│      63→    mp2 = (base_sites[b2] + base_sites[a2]) / 2.0
│      64→
│      65→    # Compute vector between midpoints
│      66→    midpoint_diff = mp2 - mp1
│      67→    l0 = jnp.linalg.norm(midpoint_diff)
│      68→    midpoint_diff /= l0
│      69→
│      70→    # Return vector and its norm
│      71→    return midpoint_diff, l0
│      72→
│      73→
