/                           # RNA2模型\n│   │   ├── __init__.py\n│   │   ├── nucleotide.py\n│   │   ├── stacking.py\n│   │   ├── interactions.py\n│   │   └── tests/\n│   └── tests/                          # 能量模块测试\n│\n├── simulators/                         # 模拟器模块 (~800行)\n│   ├── __init__.py\n│   ├── base.py                         # 基础模拟器接口\n│   ├── io.py                           # 模拟器输入/输出\n│   ├── jax_md/                         # JAX-MD模拟器\n│   │   ├── __init__.py\n│   │   ├── jaxmd.py                    # JAX-MD模拟器实现 (~120行)\n│   │   ├── utils.py                    # JAX-MD工具 (NeighborList, etc)\n│   │   └── tests/\n│   ├── oxdna/                          # oxDNA模拟器\n│   │   ├── __init__.py\n│   │   ├── oxdna.py                    # oxDNA模拟器\n│   │   ├── utils.py\n│   │   └── tests/\n│   └── tests/\n│\n├── input/                              # 输入处理模块 (~1200行)\n│   ├── __init__.py\n│   ├── toml.py                         # TOML配置解析\n│   ├── topology.py                     # 拓扑结构处理 (~320行)\n│   ├── trajectory.py                   # 轨迹处理 (~320行)\n│   ├── tree.py                         # 树形数据结构\n│   ├── oxdna_input.py                  # oxDNA输入解析\n│   ├── sequence_constraints.py         # 序列约束\n│   ├── dna1/                           # DNA1配置\n│   │   ├── default_energy.toml         # 默认能量参数\n│   │   └── default_simulation.toml     # 默认模拟参数\n│   └── tests/                          # 输入模块测试 (~1500行)\n│\n├── observables/                        # 观测量模块 (~900行)\n│   ├── __init__.py\n│   ├── base.py                         # 基础观测量类\n│   ├── pitch.py                        # 螺距观测量\n│   ├── rise.py                         # 上升观测量\n│   ├── propeller.py                    # 螺旋角观测量\n│   ├── diameter.py                     # 直径观测量\n│   ├── rmse.py                         # 均方根误差\n│   ├── persistence_length.py           # 持久长度\n│   ├── wlc.py                          # 蠕虫链模型\n│   ├── stretch_torsion.py              # 拉伸扭转\n│   └── tests/\n│\n├── optimization/                       # 优化模块 (~900行)\n│   ├── __init__.py\n│   ├── objective.py                    # 优化目标函数 (~370行)\n│   ├── optimization.py                 # 优化算法\n│   ├── simulator.py                    # 优化模拟器\n│   └── tests/\n│\n├── losses/                             # 损失函数模块\n│   ├── __init__.py\n│   ├── observable_wrappers.py          # 观测量包装器\n│   └── tests/\n│\n├── gradient_estimators/                # 梯度估计器\n│   ├── __init__.py\n│   └── difftre.py                      # DiffTRe梯度估计方法\n│\n├── utils/                              # 工具函数模块 (~600行)\n│   ├── __init__.py\n│   ├── types.py                        # 类型定义 (使用jaxtyping)\n│   ├── constants.py                    # 常数定义\n│   ├── math.py                         # 数学工具函数\n│   ├── helpers.py                      # 辅助函数\n│   ├── neighbors.py                    # 邻接表处理\n│   ├── units.py                        # 单位转换\n│   └── tests/                          # 工具测试\n│\n└── ui/                                 # 用户界面模块\n    ├── __init__.py\n    └── loggers/                        # 日志记录器\n        ├── logger.py                   # 基础日志类\n        ├── console.py                  # 控制台日志\n        ├── jupyter.py                  # Jupyter日志 (~340行)\n        └── tests/\n```\n\n### 2. JAX相关的导入和使用模式\n\n#### 2.1 JAX导入统计\n\n| JAX API | 使用次数 | 主要用途 |\n|---------|--------|--------|\n| `jax.vmap` | 77 | 向量化映射，批处理能量/观测量计算 |\n| `jax.tree_util` | 15 | PyTree操作 |\n| `jax.tree` | 10 | 树形数据结构遍历 |\n| `jax.jit` | 5 | 即时编译 |\n| `jax.lax.scan` | 4 | 循环结构 |\n\n#### 2.2 主要JAX导入模式\n\n**在能量计算中:**\n```python\nimport jax.numpy as jnp  # 所有数值计算\nimport jax  # vmap, grad, jit\nimport jax_md  # 刚体处理\n```\n\n**在模拟器中:**\n```python\nimport jax\nimport jax.numpy as jnp\nimport jax.lax  # 用于scan和控制流\nimport jax_md  # 刚体和模拟\n```\n\n**在优化中:**\n```python\nimport jax  # grad, vmap, jit, tree操作\nimport jax.numpy as jnp\nimport jax_md\n```\n\n### 3. JAX-MD的使用方式\n\n#### 3.1 核心JAX-MD组件\n\n**1. 刚体表示 (jax_md.rigid_body.RigidBody)**\n\n```python\n# 在能量函数中使用\ndef __call__(self, body: jax_md.rigid_body.RigidBody, ...) -> float:\n    # body.center: 核心位置 (N, 3)\n    # body.orientation: 方向四元数 (N, 4)\n    \n# 在模拟器中使用\nmass = jax_md.rigid_body.RigidBody(\n    center=jnp.array([nucleotide_mass], dtype=jnp.float64),\n    orientation=jnp.array([moment_of_inertia], dtype=jnp.float64),\n)\n```\n\n**2. 空间和位移函数 (jax_md.space)**\n\n```python\n# 创建位移函数\ndisplacement_fn, shift_fn = jax_md.space.free()\n\n# 应用到键合对\ndisplacement_mapped = jax_md.space.map_bond(displacement_fn)\ndr_back = displacement_mapped(body.back_sites[i], body.back_sites[j])\n```\n\n**3. 邻接表 (jax_md.partition)**\n\n```python\nfrom jax_md.partition import NeighborListFormat, neighbor_list\n\nneighbor_list_fn = neighbor_list(\n    displacement_fn,\n    box_size=box_size,\n    r_cutoff=10.0,\n    dr_threshold=0.2,\n    custom_mask_function=bonded_mask_fn,\n    format=NeighborListFormat.OrderedSparse,\n)\n```\n\n**4. 模拟器 (jax_md.simulate)**\n\n```python\n# NVT Langevin动力学\ninit_fn, step_fn = jax_md.simulate.nvt_langevin(\n    energy_fn, shift_fn, \n    dt=dt, kT=kT, gamma=gamma\n)\n\n# 初始化和步进\nstate = init_fn(key=key, R=init_positions, ...)\nstate = step_fn(state, unbonded_neighbors=neighbors)\n```\n\n### 4. 能量计算模块的结构\n\n#### 4.1 基础架构\n\n**BaseEnergyFunction**: 所有能量函数的基类\n- 提供操作符重载 (`__add__`, `__mul__`)\n- 存储位移函数\n- 定义 `__call__` 接口\n\n**ComposedEnergyFunction**: 能量函数的线性组合\n- 管理多个能量函数和权重\n- 支持 `compute_terms()` 获取各项能量\n- 支持动态添加能量函数\n\n**BaseConfiguration**: 能量参数配置\n- 管理优化参数和非优化参数\n- 支持从字典创建配置\n- 支持参数初始化 (init_params)\n\n**BaseNucleotide**: 核苷酸刚体\n- 扩展 jax_md.rigid_body.RigidBody\n- 包含额外的位置信息 (堆积位点、主链位点等)\n- 提供 from_rigid_body 工厂方法\n\n#### 4.2 能量函数层次结构\n\n```\nBaseEnergyFunction\n├── Fene (主链键能量)\n├── HydrogenBonding (氢键)\n├── Stacking (堆积)\n├── BondedExcludedVolume (键合排斥)\n├── UnbondedExcludedVolume (非键合排斥)\n├── CrossStacking (交叉堆积)\n└── CoaxialStacking (共轴堆积)\n```\n\n#### 4.3 势能函数 (jax_dna.energy.potentials)\n\n所有势能均使用 `jax.numpy` 实现，支持自动微分：\n\n| 函数 | 用途 | 方程 |\n|------|------|------|\n| `v_fene()` | FENE弹簧 | `-ε/2 * ln(1 - x²)` |\n| `v_morse()` | Morse势 (氢键/堆积) | `ε(1 - e^(-a(r-r0)))²` |\n| `v_harmonic()` | 谐波势 | `k/2 * (r - r0)²` |\n| `v_lj()` | Lennard-Jones势 | `4ε[(σ/r)¹² - (σ/r)⁶]` |\n| `v_smooth()` | 平滑截断 | `b(x_c - x)²` |\n| `v_mod()` | 调节因子 | `1 - a(θ - θ0)²` |\n\n#### 4.4 能量构建流程\n\n```python\n# 1. 定义能量函数列表\nenergy_fns = [Fene, BondedExcludedVolume, Stacking, ...]\n\n# 2. 定义能量配置列表\nenergy_configs = [FeneConfiguration(...), ...]\n\n# 3. 构建能量函数构建器\nenergy_fn_builder = jax_dna.energy.energy_fn_builder(\n    energy_fns=energy_fns,\n    energy_configs=energy_configs,\n    transform_fn=nucleotide_transform_fn,\n    displacement_fn=displacement_fn,\n)\n\n# 4. 根据参数构建能量函数\nenergy_fn = energy_fn_builder(opt_params)  # 返回 ComposedEnergyFunction\n\n# 5. 调用能量函数\ntotal_energy = energy_fn(\n    body=rigid_body,\n    seq=sequence,\n    bonded_neighbors=bonded_neighbors,\n    unbonded_neighbors=unbonded_neighbors,\n)\n```\n\n### 5. 模拟器模块的结构\n\n#### 5.1 JAX-MD模拟器 (jax_dna.simulators.jax_md)\n\n**JaxMDSimulator**: 基于JAX-MD的主要模拟器类\n\n关键属性:\n- `energy_configs`: 能量配置列表\n- `energy_fns`: 能量函数列表\n- `simulator_params`: 模拟器参数 (StaticSimulatorParams)\n- `space`: 刚体空间 (通常为自由空间)\n- `simulator_init`: 模拟器初始化函数 (如 jax_md.simulate.nvt_langevin)\n- `neighbors`: 邻接表管理器\n\n**build_run_fn()**: 构建运行函数\n\n```python\ndef run_fn(\n    opt_params: Params,\n    init_state: jax_md.rigid_body.RigidBody,\n    n_steps: int,\n    key: jax.random.PRNGKey,\n) -> SimulatorTrajectory:\n    # 1. 构建能量函数\n    energy_fn = jdna_energy.energy_fn_builder(...)(opt_params)\n    \n    # 2. 初始化模拟器\n    init_fn, step_fn = simulator_init(energy_fn, shift_fn, ...)\n    init_state = init_fn(key=key, R=init_state, ...)\n    \n    # 3. 定义单步函数\n    def apply_fn(state, _):\n        state = step_fn(state, unbonded_neighbors=neighbors.idx.T, ...)\n        neighbors = neighbors.update(state.position.center)\n        return (state, neighbors), state.position\n    \n    # 4. 使用lax.scan或checkpoint_scan进行循环\n    _, trajectory = scan_fn(jax.jit(apply_fn), (init_state, neighbors), ...)\n    \n    return SimulatorTrajectory(rigid_body=trajectory)\n```\n\n**NeighborHelper**: 邻接表管理接口\n\n两种实现:\n- `NoNeighborList`: 简单的静态邻接表\n- `NeighborList`: 动态邻接表，支持update操作\n\n**StaticSimulatorParams**: 模拟器静态参数\n- `seq`: 核苷酸序列\n- `mass`: 刚体质量\n- `gamma`: 粘滞系数\n- `bonded_neighbors`: 键合邻接\n- `dt`: 时间步长\n- `kT`: Boltzmann温度\n\n#### 5.2 JAX-MD模拟器工具 (jax_dna.simulators.jax_md.utils)\n\n**checkpoint_scan()**: 梯度检查点扫描\n\n用于内存效率的大规模模拟:\n```python\ndef checkpoint_scan(\n    f: Callable,\n    init: Any,\n    xs: Any,\n    checkpoint_every: int = 100,\n) -> tuple[Any, Any]:\n    """在checkpoints处重新计算梯度以节省内存"""\n```\n\n#### 5.3 oxDNA模拟器\n\n- `jax_dna.simulators.oxdna.oxdna.py`: oxDNA模拟器包装\n- 使用外部oxDNA可执行文件\n- 支持DiffTRe参数优化\n\n### 6. 测试文件的结构\n\n#### 6.1 测试组织\n\n总共约 `50+` 个测试文件，覆盖所有主要模块：\n\n**能量模块测试** (~400行):\n- `energy/tests/test_base.py`: BaseEnergyFunction和ComposedEnergyFunction\n- `energy/tests/test_configuration.py`: 配置类测试\n- `energy/tests/test_potentials.py`: 势能函数验证\n- `energy/dna1/tests/test_integration.py`: DNA1完整集成测试 (~400行)\n- `energy/dna2/tests/test_integration.py`: DNA2集成测试\n- 类似的测试对RNA2, NA1\n\n**模拟器测试**:\n- `simulators/jax_md/tests/test_utils.py`: JAX-MD工具测试\n- `simulators/tests/test_io.py`: 输入/输出测试\n\n**输入处理测试** (~1500行):\n- `input/tests/test_topology.py`: 拓扑解析测试 (~490行)\n- `input/tests/test_trajectory.py`: 轨迹处理测试 (~420行)\n- `input/tests/test_oxdna_input.py`: oxDNA输入解析\n\n**观测量测试**:\n- `observables/tests/test_pitch.py`: 螺距计算\n- `observables/tests/test_wlc.py`: 蠕虫链模型\n- 等等\n\n**优化和损失测试**:\n- `optimization/tests/test_objective.py`: 目标函数测试\n- `losses/tests/test_observable_wrapper.py`: 观测量包装器\n\n#### 6.2 测试工具\n\n**符号验证** (symbolic testing):\n- `energy/dna1/tests/symbolic_base_functions.py`: 使用SymPy验证基础函数\n- `energy/tests/symbolic_potentials.py`: 势能函数符号验证\n\n### 7. JAX API使用情况详解\n\n#### 7.1 JAX-NumPy (jax.numpy)\n\n**广泛使用于所有数值计算:**\n\n```python\n# 在势能函数中\ndef v_morse(r, eps, r0, a):\n    x = -(r - r0) * a\n    return eps * (1 - jnp.exp(x)) ** 2\n\n# 在观测量中\nangles = jnp.arccos(jd_math.clamp(jnp.dot(bb1_proj_dir, bb2_proj_dir)))\n\n# 在能量聚合中\nenergy_vals = jnp.array([fn(body, seq, bonded_neighbors, unbonded_neighbors) \n                         for fn in self.energy_fns])\nreturn jnp.sum(energy_vals) if self.weights is None else jnp.dot(self.weights, energy_vals)\n```\n\n#### 7.2 向量化映射 (jax.vmap)\n\n**77次使用，主要在:**\n\n1. **能量计算向量化** (最常见)\n```python\n# 在测试中向量化能量计算\nenergy = jax.vmap(\n    lambda body: energy_fn(\n        body, seq, bonded_neighbors, unbonded_neighbors\n    )\n)(bodies)\n```\n\n2. **观测量向量化**\n```python\n# 在Pitch计算中\nsingle_pitch_angle_mapped = jax.vmap(\n    single_pitch_angle, in_axes=(0, None, None, None)\n)\nangles = jax.vmap(single_pitch_angle_mapped, (None, 0, 0, None))(\n    self.quartets, base_sites, back_sites, self.displacement_fn\n)\n```\n\n3. **梯度估计**\n```python\n# 在DiffTRe中\nenergy_fn_vmap = jax.vmap(\n    lambda rigid_body: energy_fn(\n        rigid_body, seq=seq, bonded_neighbors=bonded_neighbors, ...\n    )\n)\n```\n\n#### 7.3 即时编译 (jax.jit)\n\n**5次明确使用，主要在:**\n\n1. **模拟步函数** (jax_dna/simulators/jax_md/jaxmd.py)\n```python\n_, trajectory = scan_fn(jax.jit(apply_fn), (init_state, neighbors), ...)\n```\n\n2. **用户代码中** (examples/simulations/jaxmd/jaxmd.py)\n```python\nsim_fn = jax.jit(lambda opts: simulator.run(opts, initial_positions, n_steps, key))\ntrajectory = sim_fn(params)\n```\n\n3. **测试中**\n```python\n@jax.jit\ndef state_energy_fn(state, neighbors):\n    return energy_fn(...)\n```\n\n#### 7.4 树形操作 (jax.tree, jax.tree_util)\n\n**用于参数操作:**\n\n1. **配置初始化** (energy/dna1/__init__.py)\n```python\nreturn (\n    jax.tree.map(cast_f, toml.parse_toml(config_dir.joinpath(...))),\n    jax.tree.map(cast_f, toml.parse_toml(config_dir.joinpath(...))),\n)\n```\n\n2. **类型注解** (utils/types.py)\n```python\nGrads = jaxtyp.PyTree\nParams = jaxtyp.PyTree | dict[str, jaxtyp.PyTree]\nPyTree = jaxtyp.PyTree\n```\n\n#### 7.5 控制流 (jax.lax)\n\n**用于可微循环:**\n\n1. **模拟扫描** (simulators/jax_md/jaxmd.py)\n```python\nscan_fn = (\n    jax.lax.scan\n    if simulator_params.checkpoint_every <= 0\n    else functools.partial(jaxmd_utils.checkpoint_scan, ...)\n)\n\n_, trajectory = scan_fn(jax.jit(apply_fn), (init_state, neighbors), ...)\n```\n\n### 8. 主要设计模式\n\n#### 8.1 工厂模式\n\n**能量函数构建:**\n```python\n@dataclass\nclass Fene(BaseEnergyFunction):\n    params: FeneConfiguration\n    displacement_fn: Callable\n\n# 工厂创建\nenergy_fn = Fene(\n    displacement_fn=displacement_fn,\n    params=FeneConfiguration.from_dict(params_dict),\n)\n```\n\n#### 8.2 装饰器模式\n\n**使用@chex.dataclass**\n```python\n@chex.dataclass(frozen=True)\nclass BaseEnergyFunction:\n    """冻结的数据类，支持向量化"""\n    displacement_fn: Callable\n```\n\n#### 8.3 组合模式\n\n**能量函数组合:**\n```python\nenergy_fn = Fene(...) + HydrogenBonding(...) + Stacking(...)\n# 返回 ComposedEnergyFunction，支持权重调整\n\ncomposed = ComposedEnergyFunction(\n    energy_fns=[fn1, fn2, fn3],\n    weights=jnp.array([1.0, 0.5, 2.0]),\n)\n```\n\n#### 8.4 适配器模式\n\n**刚体到核苷酸的转换:**\n```python\ntransform_fn = functools.partial(\n    jdna_energy.Nucleotide.from_rigid_body,\n    com_to_backbone=geometry["com_to_backbone"],\n    com_to_hb=geometry["com_to_hb"],\n    com_to_stacking=geometry["com_to_stacking"],\n)\n\n# 用于能量函数中\nnucleotide = transform_fn(rigid_body)\n```\n\n### 9. JAX特定技术使用\n\n#### 9.1 自动微分就绪设计\n\n所有计算使用JAX友好的操作:\n- 避免在循环中使用Python条件\n- 使用 `jnp.where()` 代替 if/else\n- 避免副作用和可变状态\n\n**例子:**\n```python\ndef f1(r, r_low, r_high, ...):\n    oob = jnp.where(\n        (r_c_low < r) & (r < r_low),\n        eps * jd_potentials.v_smooth(r, b_low, r_c_low),\n        jnp.where((r_high < r) & (r < r_c_high), ..., 0.0),\n    )\n    return jnp.where(\n        (r_low < r) & (r < r_high), \n        jd_potentials.v_morse(r, eps, r0, a) - jd_potentials.v_morse(r_c, eps, r0, a), \n        oob\n    )\n```\n\n#### 9.2 PyTree支持\n\n配置类和数据类都是PyTree:\n- 支持 `jax.tree.map()` 操作\n- 支持 `jax.grad()` 穿过这些结构\n- 支持参数化优化\n\n#### 9.3 类型检查 (JAXtyping)\n\n使用 `jaxtyping` 定义数组形状:\n```python\nArr_Nucleotide = jaxtyp.Float[jaxtyp.Array, "#n_nucleotides"]\nArr_Nucleotide_3 = jaxtyp.Float[jaxtyp.Array, "#n_nucleotides 3"]\nArr_Bonded_Neighbors_2 = jaxtyp.Int[jaxtyp.Array, "#n_bonded_pairs 2"]\n```\n\n### 10. 关键统计\n\n| 指标 | 数值 |\n|------|------|\n| 总Python文件 | 155 |\n| 总代码行数 | 4021 |\n| 能量模块行数 | ~2400 |\n| 测试文件数 | 50+ |\n| 能量函数类型 | 7 (DNA1) |\n| 支持的模型 | 4 (DNA1, DNA2, RNA2, NA1) |\n| 模拟器类型 | 2 (JAX-MD, oxDNA) |\n| 观测量类型 | 8+ |\n\n### 11. 示例流程\n\n#### 11.1 完整模拟流程\n\n```python\n# 1. 加载拓扑和初始条件\ntopology = jdna_top.from_oxdna_file("sys.top")\ninitial_positions = jdna_traj.from_file("relaxed.conf", topology.strand_counts).states[0].to_rigid_body()\n\n# 2. 获取默认配置\nexp_config, energy_config = jdna_energy.default_configs()\n\n# 3. 创建刚体变换函数\ntransform_fn = functools.partial(\n    jdna_energy.Nucleotide.from_rigid_body,\n    com_to_backbone=energy_config["geometry"]["com_to_backbone"],\n    ...\n)\n\n# 4. 获取能量函数和配置\nenergy_fn_configs = jdna_energy.default_energy_configs()\nenergy_fns = jdna_energy.default_energy_fns()\n\n# 5. 创建模拟器\nsimulator = jdna_jaxmd.JaxMDSimulator(\n    energy_configs=energy_fn_configs,\n    energy_fns=energy_fns,\n    space=jax_md.space.free(),\n    simulator_init=jax_md.simulate.nvt_langevin,\n    ...\n)\n\n# 6. 运行模拟\nkey = jax.random.PRNGKey(0)\ntrajectory = simulator.run(params, initial_positions, n_steps, key)\n```\n\n### 12. 导依赖关系\n\n```\nJAX核心\n  ├─ jax.numpy (数值计算)\n  ├─ jax (vmap, jit, grad, lax, tree操作)\n  └─ jaxtyping (类型注解)\n       │\n       ├─ JAX-MD (刚体, 模拟, 邻接表)\n       │   └─ jax_md.rigid_body (RigidBody)\n       │   └─ jax_md.space (位移函数)\n       │   └─ jax_md.simulate (NVT Langevin等)\n       │   └─ jax_md.partition (邻接表)\n       │\n       ├─ NumPy (输入解析)\n       │\n       ├─ chex (数据类, 类型检查)\n       │\n       ├─ Ray (分布式优化, 可选)\n       │\n       └─ 其他 (tqdm, plotly, ipywidgets)\n```\n\n### 13. 核心优势与特点\n\n1. **完全可微**: 所有计算使用JAX友好的操作\n2. **高度向量化**: 大量使用vmap进行批处理\n3. **模块化设计**: 清晰的能量函数、配置和模拟器分离\n4. **多模型支持**: DNA1, DNA2, RNA2, NA1四种coarse-grained模型\n5. **灵活的参数优化**: 支持直接微分和DiffTRe方法\n6. **丰富的观测量**: 8+种DNA结构观测量\n7. **类型安全**: 使用JAXtyping进行数组形状检查\n\n这个项目展示了现代科学计算中使用JAX进行生物分子模拟和参数优化的最佳实践。'}, {'type': 'text', 'text': "agentId: a319b4f (for resuming to continue this agent's work if needed)"}]
