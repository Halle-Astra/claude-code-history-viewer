│     243→
│     244→def _parse_value_in(value: str) -> int | float | str:
│     245→    for t in (int, float):
│     246→        try:
│     247→            if t is float:
│     248→                tmp_value = value.replace("f", "").lower()
│     249→                parsed = float(sympy.parse_expr(tmp_value).evalf(n=SYMPY_EVAL_N))
│     250→            else:
│     251→                parsed = t(value)
│     252→        except (AttributeError, ValueError, SyntaxError, TypeError):
│     253→            continue
│     254→        else:
│     255→            return parsed
│     256→
│     257→    return value
│     258→
│     259→
│     260→def _parse_value_out(value: int | float | str) -> str:  # noqa: PYI041 -- this is documentation specific
│     261→    if isinstance(value, int) or (isinstance(value, Tensor) and _is_integer_tensor(value)):
│     262→        parsed_value = str(value)
│     263→    elif isinstance(value, float) or (isinstance(value, Tensor) and _is_floating_tensor(value)):
│     264→        parsed_value = f"{value}f"
│     265→    elif isinstance(value, str):
│     266→        parsed_value = value
│     267→    else:
│     268→        raise TypeError(ERR_INVALID_HEADER_TYPE.format(type(value), value))
│     269→    return parsed_value
