     ```python
     def scan(f: Callable, init: Any, xs: Tensor) -> tuple:
         carry = init
         outputs = []
         for i in range(xs.shape[0]):
             carry, y = f(carry, xs[i])
             outputs.append(y)
         if len(outputs) > 0:
             if isinstance(outputs[0], jd_rb.RigidBody):
                 centers = mnp.stack([o.center for o in outputs])
                 orientations = mnp.stack([o.orientation for o in outputs])
                 stacked = jd_rb.RigidBody(center=centers, orientation=orientations)
             else:
                 stacked = mnp.stack(outputs)
         return carry, stacked
     ```

