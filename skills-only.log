│     152→def _determine_oxdna_format(first_line: str) -> tuple[typ.oxDNAFormat, Callable[[list[str]], Topology]]:
│     153→    """Determine the format of an oxDNA file from the first line of the file."""
│     154→    tokens = first_line.strip().split()
│     155→
│     156→    if len(tokens) == N_1ST_LINE_OXDNA_CLASSIC:
│     157→        fmt = typ.oxDNAFormat.CLASSIC
│     158→        func = _from_file_oxdna_classic
│     159→    elif len(tokens) == N_1ST_LINE_OXDNA_NEW:
│     160→        fmt = typ.oxDNAFormat.NEW
│     161→        func = _from_file_oxdna_new
│     162→    else:
│     163→        raise ValueError(ERR_INVALID_OXDNA_FORMAT)
│     164→
│     165→    return fmt, func
