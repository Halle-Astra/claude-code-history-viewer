│     343→        mask = mnp.array(op_i < body.dna.center.shape[0], dtype=mnp.float32)
│     344→
│     345→        dna_dgs = dna1_energy.HydrogenBonding(
│     346→            displacement_fn=self.displacement_fn, params=self.params.dna_config
│     347→        ).pairwise_energies(
│     348→            body.dna,
│     349→            body.dna,
│     350→            seq,
│     351→            unbonded_neighbors,
│     352→        )
│     353→
│     354→        rna_dgs = dna1_energy.HydrogenBonding(
│     355→            displacement_fn=self.displacement_fn, params=self.params.rna_config
│     356→        ).pairwise_energies(
│     357→            body.rna,
│     358→            body.rna,
│     359→            seq,
│     360→            unbonded_neighbors,
│     361→        )
│     362→
│     363→        drh_dgs = dna1_energy.HydrogenBonding(
│     364→            displacement_fn=self.displacement_fn, params=self.params.drh_config
│     365→        ).pairwise_energies(
│     366→            body.dna,
│     367→            body.rna,
│     368→            seq,
│     369→            unbonded_neighbors,
│     370→        )
│     371→
│     372→        rdh_dgs = dna1_energy.HydrogenBonding(
│     373→            displacement_fn=self.displacement_fn, params=self.params.drh_config
│     374→        ).pairwise_energies(
│     375→            body.rna,
│     376→            body.dna,
│     377→            seq,
│     378→            unbonded_neighbors,
│     379→        )
│     380→
│     381→        dgs = mnp.where(is_rna_bond, rna_dgs, mnp.where(is_drh_bond, drh_dgs, mnp.where(is_rdh_bond, rdh_dgs, dna_dgs)))
