│      49→def add_prefix_to_leaf_keys(data, prefix):
│      50→    """
│      51→    Recursively add a prefix to all leaf keys in a nested dictionary.
│      52→
│      53→    Args:
│      54→        data (dict): The nested dictionary representing the TOML content.
│      55→        prefix (str): The prefix to add to the leaf keys.
│      56→
│      57→    Returns:
│      58→        dict: A new dictionary with updated keys.
│      59→    """
│      60→    if isinstance(data, dict):
│      61→        # Traverse the dictionary and process each key and value
│      62→        return {
│      63→            (prefix + key if not isinstance(value, dict | list) else key): add_prefix_to_leaf_keys(value, prefix)
│      64→            for key, value in data.items()
│      65→        }
│      66→
│      67→    if isinstance(data, list):
│      68→        # Process each item in the list
│      69→        return [add_prefix_to_leaf_keys(item, prefix) for item in data]
│      70→
│      71→    # Return data as-is (not a dict or list)
│      72→    return data
