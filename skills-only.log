│       1→"""Base energy functions for DNA1 model.
│       2→
│       3→These functions are based on the oxDNA1 model paper found here:
│       4→https://ora.ox.ac.uk/objects/uuid:b2415bb2-7975-4f59-b5e2-8c022b4a3719/files/mdcac62bc9133143fc05070ed20048c50
│       5→"""
│       6→
│       7→import jax.numpy as jnp
│       8→
│       9→import jax_dna.energy.potentials as jd_potentials
│      10→import jax_dna.utils.types as typ
│      11→
│      12→
│      13→def f1(
│      14→    r: typ.ARR_OR_SCALAR,
│      15→    r_low: typ.Scalar,
│      16→    r_high: typ.Scalar,
│      17→    r_c_low: typ.Scalar,
│      18→    r_c_high: typ.Scalar,
│      19→    eps: typ.Scalar,
│      20→    a: typ.Scalar,
│      21→    r0: typ.Scalar,
│      22→    r_c: typ.Scalar,
│      23→    b_low: typ.Scalar,
│      24→    b_high: typ.Scalar,
│      25→) -> typ.ARR_OR_SCALAR:
│      26→    """The radial part of the stacking and hydrogen-bonding potentials.
│      27→
│      28→    This is based on equation 2.7 from the oxDNA paper.
│      29→    """
│      30→    oob = jnp.where(
│      31→        (r_c_low < r) & (r < r_low),
│      32→        eps * jd_potentials.v_smooth(r, b_low, r_c_low),
│      33→        jnp.where((r_high < r) & (r < r_c_high), eps * jd_potentials.v_smooth(r, b_high, r_c_high), 0.0),
│      34→    )
│      35→    return jnp.where(
│      36→        (r_low < r) & (r < r_high), jd_potentials.v_morse(r, eps, r0, a) - jd_potentials.v_morse(r_c, eps, r0, a), oob
│      37→    )
│      38→
│      39→
│      40→def f2(
│      41→    r: typ.ARR_OR_SCALAR,
│      42→    r_low: typ.Scalar,
│      43→    r_high: typ.Scalar,
