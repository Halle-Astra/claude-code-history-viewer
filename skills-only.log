│      15→    """Configuration for the debye-huckel energy function."""
│      16→
│      17→    # independent parameters
│      18→    q_eff: float | None = None
│      19→    lambda_factor: float | None = None
│      20→    prefactor_coeff: float | None = None
│      21→
│      22→    kt: float | None = None
│      23→    salt_conc: float | None = None
│      24→
│      25→    ## not optimizable
│      26→    is_end: typ.Arr_Nucleotide_Int | None = None
│      27→    half_charged_ends: bool | None = None
│      28→
│      29→    # dependent parameters
│      30→    lambda_: float | None = None
│      31→    kappa: float | None = None
│      32→    r_high: float | None = None
│      33→    prefactor: float | None = None
│      34→    smoothing_coeff: float | None = None
│      35→    r_cut: float | None = None
│      36→
│      37→    required_params: tuple[str] = (
│      38→        "q_eff",
│      39→        "lambda_factor",
│      40→        "prefactor_coeff",
│      41→        "kt",
│      42→        "salt_conc",
│      43→        "is_end",
│      44→        "half_charged_ends",
│      45→    )
│      46→
│      47→    @override
│      48→    def init_params(self) -> "DebyeConfiguration":
│      49→        lambda_ = self.lambda_factor * jnp.sqrt(self.kt / 0.1) / jnp.sqrt(self.salt_conc)
│      50→        kappa = 1.0 / lambda_
│      51→        r_high = 3 * lambda_
│      52→        prefactor = self.prefactor_coeff * (self.q_eff**2)
│      53→        smoothing_coeff = -(
│      54→            jnp.exp(-r_high / lambda_) * prefactor * prefactor * (r_high + lambda_) * (r_high + lambda_)
│      55→        ) / (-4.0 * r_high * r_high * r_high * lambda_ * lambda_ * prefactor)
│      56→        r_cut = r_high * (prefactor * r_high + 3.0 * prefactor * lambda_) / (prefactor * (r_high + lambda_))
│      57→
│      58→        return self.replace(
│      59→            lambda_=lambda_,
│      60→            kappa=kappa,
│      61→            r_high=r_high,
│      62→            prefactor=prefactor,
│      63→            smoothing_coeff=smoothing_coeff,
│      64→            r_cut=r_cut,
