│     209→        seq: typ.Discrete_Sequence,
│     210→        bonded_neighbors: typ.Arr_Bonded_Neighbors_2,
│     211→        unbonded_neighbors: typ.Arr_Unbonded_Neighbors_2,
│     212→    ) -> typ.Scalar:
│     213→        nn_i = bonded_neighbors[:, 0]
│     214→        nn_j = bonded_neighbors[:, 1]
│     215→
│     216→        # Vectorized is_rna_pair check (replacing jax.vmap)
│     217→        is_rna_bond = mnp.array([
│     218→            je_utils.is_rna_pair(nn_i[k], nn_j[k], self.params.nt_type)
│     219→            for k in range(len(nn_i))
│     220→        ])
│     221→
│     222→        dna_dgs = dna2_energy.Stacking(
│     223→            displacement_fn=self.displacement_fn, params=self.params.dna_config
│     224→        ).pairwise_energies(
│     225→            body.dna,
│     226→            seq,
│     227→            bonded_neighbors,
│     228→        )
│     229→
│     230→        rna_dgs = rna2_energy.Stacking(
│     231→            displacement_fn=self.displacement_fn, params=self.params.rna_config
│     232→        ).pairwise_energies(
│     233→            body.rna,
│     234→            seq,
│     235→            bonded_neighbors,
│     236→        )
│     237→
│     238→        # Select based on bond type
│     239→        dgs = mnp.where(is_rna_bond, rna_dgs, dna_dgs)
