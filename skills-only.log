│     195→@chex.dataclass(frozen=True)
│     196→class Stacking(je_base.BaseEnergyFunction):
│     197→    """Stacking energy function for DNA1 model."""
│     198→
│     199→    params: StackingConfiguration
│     200→
│     201→    @override
│     202→    def __call__(
│     203→        self,
│     204→        body: na1_nucleotide.HybridNucleotide,
│     205→        seq: typ.Discrete_Sequence,
│     206→        bonded_neighbors: typ.Arr_Bonded_Neighbors_2,
│     207→        unbonded_neighbors: typ.Arr_Unbonded_Neighbors_2,
│     208→    ) -> typ.Scalar:
│     209→        nn_i = bonded_neighbors[:, 0]
│     210→        nn_j = bonded_neighbors[:, 1]
│     211→
