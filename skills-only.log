│       1→"""This module contains the potential energy functions used in the oxDNA DNA1 model."""
│       2→
│       3→import jax.numpy as jnp
│       4→
│       5→import jax_dna.utils.types as jd_types
│       6→
│       7→# https://ora.ox.ac.uk/objects/uuid:b2415bb2-7975-4f59-b5e2-8c022b4a3719/files/mdcac62bc9133143fc05070ed20048c50
│       8→# Section 2.4.1
│       9→
│      10→
│      11→def v_fene(
│      12→    r: jd_types.ARR_OR_SCALAR, eps: jd_types.Scalar, r0: jd_types.Scalar, delt: jd_types.Scalar
│      13→) -> jd_types.ARR_OR_SCALAR:
│      14→    """FENE spring (used to connect backbones).
│      15→
│      16→    This is based on equation 2.1 from the oxDNA paper.
│      17→    """
│      18→    x = (r - r0) ** 2 / delt**2
│      19→    return -eps / 2.0 * jnp.log(1 - x)
│      20→
│      21→
│      22→def v_morse(
│      23→    r: jd_types.ARR_OR_SCALAR,
│      24→    eps: jd_types.Scalar,
│      25→    r0: jd_types.Scalar,
│      26→    a: jd_types.Scalar,
│      27→) -> jd_types.ARR_OR_SCALAR:
│      28→    """Morse potential (used for stacking and H-bonding).
│      29→
│      30→    This is based on equation 2.2 from the oxDNA paper.
│      31→    """
│      32→    x = -(r - r0) * a
│      33→    return eps * (1 - jnp.exp(x)) ** 2
│      34→
│      35→
│      36→def v_harmonic(
│      37→    r: jd_types.ARR_OR_SCALAR,
│      38→    k: jd_types.Scalar,
│      39→    r0: jd_types.Scalar,
│      40→) -> jd_types.ARR_OR_SCALAR:
│      41→    """Harmonic potential (used for cross-stacking and coaxial stacking).
│      42→
│      43→    This is based on equation 2.3 from the oxDNA paper.
│      44→    """
│      45→    return k / 2 * (r - r0) ** 2
│      46→
│      47→
│      48→def v_lj(r: jd_types.ARR_OR_SCALAR, eps: jd_types.Scalar, sigma: jd_types.Scalar) -> jd_types.ARR_OR_SCALAR:
│      49→    """Lennard - Jones potential (used for soft repulsion).
│      50→
│      51→    This is based on equation 2.4 from the oxDNA paper.
│      52→    """
│      53→    x = (sigma / r) ** 12 - (sigma / r) ** 6
│      54→    return 4 * eps * x
│      55→
│      56→
│      57→def v_mod(theta: jd_types.ARR_OR_SCALAR, a: jd_types.Scalar, theta0: jd_types.Scalar) -> jd_types.ARR_OR_SCALAR:
│      58→    """Quadratic terms (used for modulation).
│      59→
│      60→    This is based on equation 2.5 from the oxDNA paper.
│      61→    """
│      62→    return 1 - a * (theta - theta0) ** 2
│      63→
│      64→
│      65→def v_smooth(x: jd_types.ARR_OR_SCALAR, b: jd_types.Scalar, x_c: jd_types.Scalar) -> jd_types.ARR_OR_SCALAR:
│      66→    """Quadratic smoothing terms for truncation.
│      67→
│      68→    This is based on equation 2.6 from the oxDNA paper.
│      69→    """
│      70→    return b * (x_c - x) ** 2
│      71→
