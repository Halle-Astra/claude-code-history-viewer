│     129→    """
│     130→
│     131→    quartets: jnp.ndarray = dc.field(hash=False)
│     132→    displacement_fn: Callable
│     133→
│     134→    def __post_init__(self) -> None:
│     135→        """Validate the input."""
│     136→        if self.rigid_body_transform_fn is None:
│     137→            raise ValueError(jd_obs.ERR_RIGID_BODY_TRANSFORM_FN_REQUIRED)
│     138→
│     139→    def __call__(self, trajectory: jd_sio.SimulatorTrajectory) -> tuple[jnp.ndarray, jd_types.ARR_OR_SCALAR]:
│     140→        """Calculate aligment decay and average distance correlations for adjacent base pairs.
│     141→
│     142→        Args:
│     143→            trajectory (jd_traj.Trajectory): the trajectory to calculate the rise for
│     144→
│     145→        Returns:
│     146→            Tuple[jnp.ndarray, jd_types.ARR_OR_SCALAR]: the correlations in alignment decay and the the average
│     147→            distance between adjacent base pairs for each state. The former will have shape (n_states, n_quartets-1)
│     148→            and the latter will have shape (n_states,).
│     149→        """
│     150→        nucleotides = jax.vmap(self.rigid_body_transform_fn)(trajectory.rigid_body)
