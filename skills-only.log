"""JAX-DNA: DNA nanostructure design using JAX-based sequence optimization.

This package provides tools for designing DNA nanostructures through
gradient-based sequence optimization. It includes:

- Energy models (oxDNA1, oxDNA2, RNA, NA) for DNA/RNA interactions
- Simulators (JAX-MD, oxDNA) for molecular dynamics
- Observables for analyzing structural properties
- Optimization framework for sequence design
- Input/output utilities for various file formats

Example:
    Basic usage for sequence optimization::

        from jax_dna import DNASimulator, SequenceOptimizer
        from jax_dna.energy import DNA2Energy
        from jax_dna.observables import RMSE

        # Load structure
        simulator = DNASimulator.from_files("system.top", "init.conf")

        # Setup optimization
        energy_fn = DNA2Energy()
        observable = RMSE(target_structure)
        optimizer = SequenceOptimizer(
            simulator=simulator,
            energy_fn=energy_fn,
            observable=observable
        )

        # Optimize sequence
        result = optimizer.optimize(num_steps=1000)
"""

from importlib.metadata import version

# Version
__version__ = version("jax-dna")

# Core functionality
from jax_dna.energy import (
    DNA1Energy,
    DNA2Energy,
    EnergyFunction,
    NA1Energy,
    RNA2Energy,
)
from jax_dna.gradient_estimators import DiffTRE
from jax_dna.input import (
    ConstraintSpec,
    OxDNAInput,
    SequenceConstraints,
    Topology,
    Trajectory,
)
from jax_dna.losses import ObservableWrapper
from jax_dna.observables import (
    Diameter,
    Observable,
    PersistenceLength,
    Pitch,
    Propeller,
    RMSE,
    Rise,
    StretchTorsion,
    WLC,
)
from jax_dna.optimization import Objective, Optimizer, Simulator
from jax_dna.simulators import JaxMDSimulator, OxDNASimulator
from jax_dna.ui.loggers import ConsoleLogger, JupyterLogger, Logger
from jax_dna.utils import constants

__all__ = [
    # Version
    "__version__",
    # Energy
    "DNA1Energy",
    "DNA2Energy",
    "EnergyFunction",
    "NA1Energy",
    "RNA2Energy",
    # Gradient estimators
    "DiffTRE",
    # Input
    "ConstraintSpec",
    "OxDNAInput",
    "SequenceConstraints",
    "Topology",
    "Trajectory",
    # Losses
    "ObservableWrapper",
    # Observables
    "Diameter",
    "Observable",
    "PersistenceLength",
    "Pitch",
    "Propeller",
    "RMSE",
    "Rise",
    "StretchTorsion",
    "WLC",
    # Optimization
    "Objective",
    "Optimizer",
    "Simulator",
    # Simulators
    "JaxMDSimulator",
    "OxDNASimulator",
    # UI
    "ConsoleLogger",
    "JupyterLogger",
    "Logger",
    # Utils
    "constants",
]
</parameter>

