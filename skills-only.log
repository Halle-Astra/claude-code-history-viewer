│       1→"""DNA2 interactions.
│       2→
│       3→These functions are based on the oxDNA2 model paper found here:
│       4→https://arxiv.org/abs/1504.00821
│       5→"""
│       6→
│       7→import jax.numpy as jnp
│       8→import jax.tree_util as tu
│       9→
│      10→import jax_dna.energy.dna1.base_functions as jd_base_functions1
│      11→import jax_dna.energy.dna2.base_functions as jd_base_functions2
│      12→import jax_dna.utils.types as typ
│      13→
│      14→
│      15→def debye(
│      16→    r: typ.ARR_OR_SCALAR,
│      17→    kappa: typ.Scalar,
│      18→    prefactor: typ.Scalar,
│      19→    smoothing_coeff: typ.Scalar,
│      20→    r_cut: typ.Scalar,
│      21→    r_high: typ.Scalar,
│      22→) -> typ.ARR_OR_SCALAR:
│      23→    """Debye-huckel potential."""
│      24→    energy_full = jnp.exp(r * -kappa) * (prefactor / r)
│      25→    energy_smooth = smoothing_coeff * (r - r_cut) ** 2
│      26→    cond = r < r_high
│      27→    energy = jnp.where(cond, energy_full, energy_smooth)
│      28→    return jnp.where(r < r_cut, energy, 0.0)
│      29→
│      30→
│      31→def coaxial_stacking(
│      32→    # obersvables
│      33→    dr_stack: typ.ARR_OR_SCALAR,
│      34→    theta4: typ.ARR_OR_SCALAR,
