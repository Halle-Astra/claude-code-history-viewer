│      77→def vector_autocorrelate(vecs: jnp.ndarray) -> jnp.ndarray:
│      78→    """Computes the average correlations in alignment decay between a list of vector.
│      79→
│      80→    Given an ordered list of n vectors (representing vectors between adjacent base pairs),
│      81→    computes the average correlation between all pairs of vectors separated by a distance `d`
│      82→    for all distances `d < n`. Note that multiple pairs of vectors are included for all
│      83→    values < n-1.
│      84→
│      85→    Args:
│      86→        vecs (jnp.ndarray): a (n, 3) array of vectors corresponding to displacements between midpoints of adjacent
│      87→            base pairs.
│      88→
│      89→    """
│      90→    max_dist = vecs.shape[0]
│      91→
│      92→    def window_correlations(i: int) -> jnp.ndarray:
│      93→        li = vecs[i]
│      94→
│      95→        def i_correlation_fn(j: int) -> jnp.ndarray:
│      96→            return jnp.where(j >= i, jnp.dot(li, vecs[j]), 0.0)
│      97→
│      98→        i_correlations = vmap(i_correlation_fn)(jnp.arange(max_dist))
│      99→        return jnp.roll(i_correlations, -i)
│     100→
│     101→    all_correlations = vmap(window_correlations)(jnp.arange(max_dist))
│     102→    all_correlations = jnp.sum(all_correlations, axis=0)
│     103→
│     104→    all_correlations /= jnp.arange(max_dist, 0, -1)
│     105→    return all_correlations
