│     167→
│     168→def _get_bonded_neighbors(
│     169→    strand_lengths: list[int],
│     170→    is_circular: list[bool],
│     171→) -> list[tuple[int, int]]:
│     172→    """Convert 5' neighbors to bonded neighbors by index."""
│     173→    if len(strand_lengths) != len(is_circular):
│     174→        raise ValueError(ERR_STRAND_COUNTS_CIRCULAR_MISMATCH)
│     175→
│     176→    bonded_neighbors = []
│     177→    init_idx = 0
│     178→    for i, length in enumerate(strand_lengths):
│     179→        pairs = list(itertools.pairwise(range(init_idx, init_idx + length)))
│     180→        if is_circular[i]:
│     181→            # the ordering here in intentional
│     182→            pairs.append((init_idx, init_idx + length - 1))
│     183→        bonded_neighbors.extend(pairs)
│     184→        init_idx += length
│     185→    return bonded_neighbors
│     186→
│     187→
│     188→def _get_unbonded_neighbors(n_nucleotides: int, bonded_neighbors: list[tuple[int, int]]) -> list[tuple[int, int]]:
│     189→    """Get unbonded neighbors."""
│     190→    all_possible_pairs = set(itertools.combinations(range(n_nucleotides), 2))
│     191→    self_bonds = {(i, i) for i in range(n_nucleotides)}
│     192→    return list(all_possible_pairs - set(bonded_neighbors) - self_bonds)
│     193→
│     194→
│     195→def _from_file_oxdna_classic(lines: list[str]) -> Topology:
│     196→    """Read topology information from a file in the classix oxDNA format.
│     197→
│     198→    See https://lorenzo-rovigatti.github.io/oxDNA/configurations.html#topology-file
│     199→    for more information.
│     200→
│     201→    Args:
│     202→        lines (List[str]): lines from topology file
│     203→
│     204→    Returns:
│     205→        Topology: Topology object
│     206→
│     207→    """
│     208→    n_nucleotides, n_strands = list(map(int, lines[0].strip().split()))
│     209→
│     210→    # after the first line the topology files are space delimited with the
│     211→    # following columns:
│     212→    # - strand id (1 indexed)
│     213→    # - nucleotide base (A=0, C=1, G=2, T=3, U=3), use char for now
│     214→    # - 3' neighbor (0-indexed), -1 if none, -1 indicates the stand isn't circular
│     215→    # - 5' neighbor (0-indexed), -1 if none
│     216→    #
│     217→    # A more common convention is to store the nucleotides in the 5' -> 3' direction
│     218→    # so we need to reverse the order, which seems to be as easy as reversing the
│     219→    # order of the nucleotides per strand.
│     220→
│     221→    strand_ids, bases, _, neighbor_5p = list(zip(*[line.strip().split() for line in lines[1:]], strict=True))
│     222→    strand_ids = list(map(int, strand_ids))
│     223→    _, strand_counts = np.unique(strand_ids, return_counts=True)
│     224→    neighbor_5p = list(map(int, neighbor_5p))
│     225→
│     226→    reversed_bases = []
│     227→    is_circular = []
│     228→    is_end = []
│     229→    nt_type = []
│     230→    for i in range(1, n_strands + 1):
│     231→        strand_bases, strand_5p = zip(
│     232→            *[
│     233→                id_nucleotide[1:]
│     234→                for id_nucleotide in zip(strand_ids, bases, neighbor_5p, strict=True)
│     235→                if id_nucleotide[0] == i
│     236→            ],
│     237→            strict=True,
│     238→        )
│     239→        strand_is_circular = strand_5p[-1] != -1
│     240→        is_circular.append(strand_is_circular)
│     241→        reversed_bases.extend(strand_bases[::-1])
│     242→
│     243→        strand_length = len(strand_bases)
│     244→        strand_is_end = [0 for _ in range(strand_length)]
│     245→        if not strand_is_circular:
│     246→            strand_is_end[0] = 1
│     247→            strand_is_end[-1] = 1
│     248→        is_end.extend(strand_is_end)
│     249→
│     250→        # Classic format doesn't permit type specification
│     251→        if "T" in strand_bases:
│     252→            nt_type.extend([NucleotideType.DNA] * strand_length)
│     253→        elif "U" in strand_bases:
│     254→            nt_type.extend([NucleotideType.RNA] * strand_length)
│     255→        else:
│     256→            warnings.warn(WARN_CLASSIC_UNSPECIFIED_NT_TYPE.format(strand_idx=i), stacklevel=1)
│     257→            nt_type.extend([NucleotideType.UNSPECIFIED] * strand_length)
│     258→
│     259→    sequence = "".join(reversed_bases)
│     260→
│     261→    bonded_neighbors = _get_bonded_neighbors(strand_counts, is_circular)
│     262→
│     263→    unbonded_neighbors = _get_unbonded_neighbors(n_nucleotides, bonded_neighbors)
│     264→
│     265→    return Topology(
│     266→        n_nucleotides=n_nucleotides,
│     267→        strand_counts=strand_counts,
│     268→        bonded_neighbors=np.array(list(bonded_neighbors)),
│     269→        unbonded_neighbors=np.array(list(unbonded_neighbors)),
│     270→        seq=Tensor([jd_const.NUCLEOTIDES_IDX[s] for s in sequence]).astype(mnp.int32),
│     271→        is_end=Tensor(is_end).astype(mnp.int32),
│     272→        nt_type=Tensor(nt_type).astype(mnp.int32),
│     273→    )
│     274→
│     275→
│     276→def _from_file_oxdna_new(lines: list[str]) -> Topology:
│     277→    # the first line of the new oxDNA format is:
│     278→    # n_nucleotides n_strands 5->3
│     279→    # we don't need the 5->3, so we'll just ignore it
│     280→    n_nucleotides, n_strands = list(map(int, lines[0].strip().split()[:-1]))
│     281→
│     282→    # the rest of the new oxDNA file format is laid out as follows:
│     283→    # nucleotides k=v
│     284→    # ...
│     285→    # nucleotides k=v
│     286→    # Where `nuclotides` is a string of ACTG and `k=v` is a set of key value pairs
│     287→    # the lines are repeated n_stand times
│     288→
│     289→    sequence = []
│     290→    strand_counts = []
│     291→    is_circular = []
│     292→    is_end = []
│     293→    nt_type = []
│     294→    for line in lines[1:]:
│     295→        nucleotides = line.strip().split()[0]
│     296→        sequence.append(nucleotides)
│     297→        strand_counts.append(len(nucleotides))
│     298→        strand_is_circular = "circular=true" in line
│     299→        is_circular.append(strand_is_circular)
│     300→
│     301→        strand_length = len(nucleotides)
│     302→        strand_is_end = [0 for _ in range(strand_length)]
│     303→        if not strand_is_circular:
│     304→            strand_is_end[0] = 1
│     305→            strand_is_end[-1] = 1
│     306→        is_end.extend(strand_is_end)
│     307→
│     308→        strand_is_dna = "type=DNA" in line
│     309→        strand_is_rna = "type=RNA" in line
│     310→        if strand_is_dna:
│     311→            strand_nt_type = [NucleotideType.DNA] * strand_length
│     312→        elif strand_is_rna:
│     313→            strand_nt_type = [NucleotideType.RNA] * strand_length
│     314→        else:
│     315→            warnings.warn(WARN_NEW_UNSPECIFIED_NT_TYPE.format(strand_idx=line), stacklevel=1)
│     316→            strand_nt_type = [NucleotideType.UNSPECIFIED] * strand_length
│     317→        nt_type.extend(strand_nt_type)
│     318→
│     319→    sequence = "".join(sequence)
│     320→
│     321→    bonded_neighbors = _get_bonded_neighbors(strand_counts, is_circular)
│     322→    unbonded_neighbors = _get_unbonded_neighbors(n_nucleotides, bonded_neighbors)
│     323→
│     324→    return Topology(
│     325→        n_nucleotides=n_nucleotides,
│     326→        strand_counts=np.array(strand_counts),
│     327→        bonded_neighbors=np.array(bonded_neighbors),
│     328→        unbonded_neighbors=np.array(unbonded_neighbors),
│     329→        seq=Tensor([jd_const.NUCLEOTIDES_IDX[s] for s in sequence]).astype(mnp.int32),
│     330→        is_end=Tensor(is_end).astype(mnp.int32),
│     331→        nt_type=Tensor(nt_type).astype(mnp.int32),
│     332→    )
│     333→
