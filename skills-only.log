│      77→
│      78→def clamp(x: typ.ARR_OR_SCALAR, lo: typ.Scalar = -1.0, hi: typ.Scalar = 1.0) -> typ.ARR_OR_SCALAR:
│      79→    """Clamp a value between two values."""
│      80→    clipped_max = jnp.where(x >= hi, hi, x)
