│      19→    """Computes the angle in the X-Y plane between adjacent base pairs."""
│      20→    # Extract the base pairs
│      21→    bp1, bp2 = quartet[0], quartet[1]
│      22→    a1, b1 = int(bp1[0]), int(bp1[1])
│      23→    a2, b2 = int(bp2[0]), int(bp2[1])
│      24→
│      25→    # Compute the vector between base sites for each base pair
│      26→    bb1 = displacement_fn(base_sites[b1], base_sites[a1])
│      27→    bb2 = displacement_fn(base_sites[b2], base_sites[a2])
│      28→
