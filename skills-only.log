     def q_to_back_base(q: Tensor) -> Tensor:
         q0, q1, q2, q3 = q[:, 0], q[:, 1], q[:, 2], q[:, 3]
         v0 = q0**2 + q1**2 - q2**2 - q3**2
         return mnp.stack([v0, v1, v2], axis=-1)
     ```

