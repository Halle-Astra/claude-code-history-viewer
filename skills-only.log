│     137→def from_oxdna_file(path: typ.PathOrStr) -> Topology:
│     138→    """Read topology information from an oxDNA file."""
│     139→    path = Path(path)
│     140→
│     141→    if not path.exists():
│     142→        raise FileNotFoundError(ERR_FILE_NOT_FOUND)
│     143→
│     144→    with path.open() as f:
