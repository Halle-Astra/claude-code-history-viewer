│     313→class HydrogenBonding(je_base.BaseEnergyFunction):
│     314→    """Hydrogen bonding energy function for NA1 model."""
│     315→
│     316→    params: HydrogenBondingConfiguration = None
│     317→
│     318→    @override
│     319→    def __call__(
│     320→        self,
│     321→        body: na1_nucleotide.HybridNucleotide,
│     322→        seq: typ.Sequence,
│     323→        bonded_neighbors: typ.Arr_Bonded_Neighbors_2,
│     324→        unbonded_neighbors: typ.Arr_Unbonded_Neighbors_2,
│     325→    ) -> typ.Scalar:
│     326→        op_i = unbonded_neighbors[0]
│     327→        op_j = unbonded_neighbors[1]
│     328→
│     329→        # Vectorized pair checks (replacing jax.vmap)
│     330→        is_rna_bond = mnp.array([
│     331→            je_utils.is_rna_pair(op_i[k], op_j[k], self.params.nt_type)
│     332→            for k in range(len(op_i))
│     333→        ])
│     334→        is_drh_bond = mnp.array([
│     335→            je_utils.is_dna_rna_pair(op_i[k], op_j[k], self.params.nt_type)
│     336→            for k in range(len(op_i))
│     337→        ])
│     338→        is_rdh_bond = mnp.array([
│     339→            je_utils.is_dna_rna_pair(op_j[k], op_i[k], self.params.nt_type)
│     340→            for k in range(len(op_j))
│     341→        ])
