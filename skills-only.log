│      75→def merge_dicts(dict1, dict2):
│      76→    """
│      77→    Recursively merge two dictionaries. If a key exists in both:
│      78→    - If the values are dictionaries, merge them recursively.
│      79→    - Otherwise, the value from dict2 overwrites dict1.
│      80→
│      81→    Args:
│      82→        dict1 (dict): The first dictionary.
│      83→        dict2 (dict): The second dictionary.
│      84→
│      85→    Returns:
│      86→        dict: A new dictionary with merged contents.
│      87→    """
│      88→    merged = dict1.copy()  # Start with a copy of dict1
│      89→    for key, value in dict2.items():
│      90→        if key in merged:
│      91→            if isinstance(merged[key], dict) and isinstance(value, dict):
│      92→                # Recursively merge dictionaries
│      93→                merged[key] = merge_dicts(merged[key], value)
