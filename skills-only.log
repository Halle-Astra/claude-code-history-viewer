│       1→"""Math utilities for DNA sequence analysis."""
│       2→
│       3→import jax.numpy as jnp
│       4→import numpy as np
│       5→
│       6→import jax_dna.utils.types as typ
│       7→
│       8→
│       9→def principal_axes_to_euler_angles(
│      10→    x: typ.Arr_Nucleotide_3,
│      11→    y: typ.Arr_Nucleotide_3,
│      12→    z: typ.Arr_Nucleotide_3,
│      13→) -> tuple[typ.Arr_Nucleotide, typ.Arr_Nucleotide, typ.Arr_Nucleotide]:
│      14→    """Convert principal axes to Tait-Bryan Euler angles.
│      15→
│      16→    A utility function for converting a set of principal axes
│      17→    (that define a rotation matrix) to a commonly used set of
│      18→    Tait-Bryan Euler angles.
│      19→
│      20→    There are two options to compute the Tait-Bryan angles. Each can be seen at the respective links:
│      21→    (1) From wikipedia (under Tait-Bryan angles): https://en.wikipedia.org/wiki/Euler_angles
│      22→    (2) Equation 10A-C: https://danceswithcode.net/engineeringnotes/rotations_in_3d/rotations_in_3d_part1.html
│      23→
│      24→    However, note that the definition from Wikipedia (i.e. the one using arcsin) has numerical stability issues,
│      25→    so we use the definition from (2) (i.e. the one using arctan2)
│      26→
│      27→    Note that if we were following (1), we would do:
│      28→    psi = onp.arcsin(x[1] / onp.sqrt(1 - x[2]**2))
│      29→    theta = onp.arcsin(-x[2])
│      30→    phi = onp.arcsin(y[2] / onp.sqrt(1 - x[2]**2))
│      31→
│      32→    Note that Tait-Bryan (i.e. Cardan) angles are *not* proper euler angles
│      33→    """
│      34→    psi = np.arctan2(x[:, 1], x[:, 0])
│      35→    theta = np.arcsin(-np.clip(x[:, 2], -1, 1))
│      36→    phi = np.arctan2(y[:, 2], z[:, 2])
│      37→
│      38→    return (psi, theta, phi)
│      39→
│      40→
│      41→def euler_angles_to_quaternion(
│      42→    psi: typ.Arr_Nucleotide,
│      43→    theta: typ.Arr_Nucleotide,
│      44→    phi: typ.Arr_Nucleotide,
│      45→) -> typ.Arr_Nucleotide_4:
│      46→    """Convert Euler angles to quaternions.
│      47→
│      48→    A utility function for converting euler angles to quaternions.
│      49→    Used when converting a trajectory DataFrame to a set of states.
│      50→
│      51→    We follow the ZYX convention. For details, see page A-11 in
│      52→    https://ntrs.nasa.gov/api/citations/19770024290/downloads/19770024290.pdf
│      53→    from the following set of documentation:
│      54→    https://ntrs.nasa.gov/citations/19770024290
│      55→    """
│      56→    sin_psi, cos_psi = np.sin(0.5 * psi), np.cos(0.5 * psi)
│      57→    sin_theta, cos_theta = np.sin(0.5 * theta), np.cos(0.5 * theta)
│      58→    sin_phi, cos_phi = np.sin(0.5 * phi), np.cos(0.5 * phi)
│      59→
│      60→    q0 = sin_psi * sin_theta * sin_phi + cos_psi * cos_theta * cos_phi
│      61→    q1 = -sin_psi * sin_theta * cos_phi + sin_phi * cos_psi * cos_theta
│      62→    q2 = sin_psi * cos_theta * sin_phi + cos_psi * sin_theta * cos_phi
│      63→    q3 = sin_psi * cos_theta * cos_phi - cos_psi * sin_theta * sin_phi
│      64→
│      65→    return np.array([q0, q1, q2, q3]).T
│      66→
│      67→
│      68→def smooth_abs(x: typ.ARR_OR_SCALAR, eps: typ.Scalar = 1e-10) -> typ.ARR_OR_SCALAR:
│      69→    """A smooth absolute value function.
│      70→
│      71→    Note that a non-zero eps gives continuous first dervatives.
│      72→
│      73→    https://math.stackexchange.com/questions/1172472/differentiable-approximation-of-the-absolute-value-function
│      74→    """
│      75→    return jnp.sqrt(x**2 + eps)
│      76→
│      77→
│      78→def clamp(x: typ.ARR_OR_SCALAR, lo: typ.Scalar = -1.0, hi: typ.Scalar = 1.0) -> typ.ARR_OR_SCALAR:
│      79→    """Clamp a value between two values."""
│      80→    clipped_max = jnp.where(x >= hi, hi, x)
│      81→    return jnp.where(clipped_max <= lo, lo, clipped_max)
│      82→
│      83→
│      84→# This is an idea to prototype a function that we ca use to benchmark different
│      85→# implementations of the same function.
│      86→def mult(a: typ.Arr_N, b: typ.Arr_N) -> typ.Arr_N:
│      87→    """Element-wise multiplication of two arrays w/ sum reduction."""
│      88→    return jnp.einsum("ij, ij->i", a, b)
