│      22→    energy_fns: tuple[jd_energy_fn.BaseEnergyFunction],
│      23→    energy_configs: tuple[jd_energy_cnfg.BaseConfiguration],
│      24→    rigid_body_transform_fn: Callable,
│      25→    seq: jd_types.Sequence,  # make sure this is jax
│      26→    bonded_neighbors: jnp.ndarray,
│      27→    unbonded_neighbors: jnp.ndarray,
│      28→) -> jd_energy_fn.ComposedEnergyFunction:
│      29→    """Builds the energy function for the given parameters."""
│      30→    initialized_energy_fns = [
│      31→        e_fn(
│      32→            displacement_fn=displacement_fn,
│      33→            params=(e_c | op).init_params(),
│      34→        )
│      35→        for op, e_fn, e_c in zip(opt_params, energy_fns, energy_configs, strict=True)
│      36→    ]
│      37→
│      38→    energy_fn = jd_energy_fn.ComposedEnergyFunction(
│      39→        energy_fns=initialized_energy_fns,
│      40→        rigid_body_transform_fn=rigid_body_transform_fn,
│      41→    )
│      42→
│      43→    # The unvmapped version of this function operates on a single rigid body
│      44→    # with rigid_body.center \in R^nx3 and rigid_body.orientation \in R^nx4
│      45→    # The vmap version of this function operates on a batch of rigid bodies
│      46→    # with rigid_body.center \in R^bxnx3 and rigid_body.orientation \in R^bxnx4
│      47→    return jax.vmap(
│      48→        lambda rigid_body: energy_fn(
│      49→            rigid_body,
│      50→            seq=seq,
│      51→            bonded_neighbors=bonded_neighbors,
│      52→            unbonded_neighbors=unbonded_neighbors,
│      53→        )
│      54→    )
│      55→
│      56→
│      57→def _compute_states_energies(
