│      22→
│      23→
│      24→@chex.dataclass
│      25→class SquaredError(LossFn):
│      26→    """Calculate the squared error between the actual and target values."""
│      27→
│      28→    @override
│      29→    def __call__(self, actual: jnp.ndarray, target: jnp.ndarray) -> float:
│      30→        return (target - actual) ** 2
│      31→
│      32→
│      33→@chex.dataclass
│      34→class RootMeanSquaredError(LossFn):
│      35→    """Calculate the root mean squared error between the actual and target values."""
│      36→
│      37→    @override
