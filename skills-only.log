│     157→def stretch(forces: Tensor, extensions: Tensor) -> tuple[float, float, float]:
│     158→    r"""Computes the effective stretch modulus and relevant summary statistics from stretch experiments.
│     159→
│     160→    Following Assenza and Perez (JCTC 2022), the effective stretch modulus can be computed as
│     161→
│     162→    .. math::
│     163→      \tilde{S} = \frac{L_0}{A_1}
│     164→
│     165→    where `A_1` and `L_0` are the slope and offset, respectively, of a linear force-extension fit.
│     166→
│     167→    Args:
│     168→        forces (Tensor): the forces applied to the polymer
│     169→        extensions (Tensor): the equilibrium extensions under the applied forces
│     170→
│     171→    Returns:
│     172→        Tuple[float, float, float]: the slope and offset of the linear fit, and the effective stretch modulus
│     173→    """
│     174→    # Format the forces for line-fitting
│     175→    forces_ = mnp.stack([mnp.ones_like(forces), forces], axis=1)
│     176→
│     177→    # Fit a line
│     178→    # Note: we do not fix l0 to be the extension under 0 force. We fit it as a parameter.
│     179→    fit_ = mnp.linalg.lstsq(forces_, extensions)
│     180→
│     181→    # Extract statistics
│     182→    a1 = fit_[0][1]
│     183→    l0 = fit_[0][0]  # Note: this is the equilibrium extension at 0 force and torque, *not* the contour length
│     184→
│     185→    # Compute effective stretch modulus
│     186→    s_eff = l0 / a1
│     187→    return a1, l0, s_eff
