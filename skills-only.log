│      49→    b_low: typ.Scalar,
│      50→    b_high: typ.Scalar,
│      51→) -> typ.ARR_OR_SCALAR:
│      52→    """The radial part of the cross-stacking and coaxial stacking potentials.
│      53→
│      54→    This is based on equation 2.8 from the oxDNA paper.
│      55→    """
│      56→    oob = jnp.where(
│      57→        (r_c_low < r) & (r < r_low),
│      58→        k * jd_potentials.v_smooth(r, b_low, r_c_low),
