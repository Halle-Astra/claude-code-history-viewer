│     174→    strand_lengths: list[int],
│     175→    *,
│     176→    is_oxdna: bool = True,
│     177→    n_processes: int = 1,
│     178→) -> Trajectory:
│     179→    """Parse a trajectory file.
│     180→
│     181→    Trajectory files are in the following format:
│     182→    t = number
│     183→    b = number number number
│     184→    E = number number number
│     185→    com_x com_y com_z a1_x a1_y a1_z a3_x a3_y a3_z v_x v_y v_z L_x L_y L_z
│     186→    ...repeated n_nucleotides times in total
│     187→    com_x com_y com_z a1_x a1_y a1_z a3_x a3_y a3_z v_x v_y v_z L_x L_y L_z
│     188→
│     189→    where the com_x, ..., L_z are all floating point numbers.
│     190→
│     191→    This can be repeated a total of "timestep" number of times.
│     192→
│     193→    In oxDNA the states are stored in 3'->5' order so we flip the order per strand
│     194→    and need the topology to get the boundaries of each strand.
│     195→
│     196→    Args:
│     197→        path (PathOrStr): path to the trajectory file
│     198→        strand_lengths (list[int]): if this is an oxDNA trajectory,
│     199→            the lengths of each strand, so that they can be flipped to 5'->3' order
│     200→        is_oxdna (bool): whether the trajectory is in oxDNA format
│     201→        n_processes (int): number of processors to use for reading the file
│     202→
│     203→    Returns:
│     204→        Trajectory: trajectory information
│     205→
│     206→    """
│     207→    path = Path(path)
│     208→
│     209→    if not path.exists():
│     210→        raise FileNotFoundError(ERR_TRAJECTORY_FILE_NOT_FOUND.format(path))
│     211→
│     212→    boundaries = np.linspace(0, path.stat().st_size, n_processes + 1, dtype=np.int64)
│     213→    n_runs = len(boundaries) - 1
│     214→    with cf.ProcessPoolExecutor(n_processes, mp_context=mp.get_context("spawn")) as pool:
│     215→        vals = list(
│     216→            pool.map(
│     217→                _read_file_process_wrapper,
│     218→                zip(
│     219→                    itertools.repeat(path, times=n_runs),
│     220→                    boundaries[:-1],
│     221→                    boundaries[1:],
│     222→                    itertools.repeat(strand_lengths, times=n_runs),
│     223→                    itertools.repeat(is_oxdna, times=n_runs),
│     224→                    strict=True,
│     225→                ),
│     226→            ),
│     227→        )
│     228→
│     229→    # this is now an list of iterables where each iterable is a concatenated
│     230→    # list of the output of _read_file for each process
│     231→    concatenated_vals = list(
│     232→        map(
│     233→            itertools.chain.from_iterable,
│     234→            zip(*vals, strict=False),
│     235→        )
│     236→    )
│     237→
│     238→    # convert the iterables to lists and unpack list
│     239→    ts, bs, es, states = list(map(list, concatenated_vals))
│     240→
│     241→    validate_box_size(bs)
│     242→
│     243→    return Trajectory(
│     244→        n_nucleotides=sum(strand_lengths),
│     245→        strand_lengths=strand_lengths,
│     246→        times=np.array(ts, dtype=np.float64),
│     247→        energies=np.array(es, dtype=np.float64),
│     248→        states=[NucleotideState(array=s) for s in states],
│     249→    )
│     250→
│     251→
│     252→def _read_file_process_wrapper(
│     253→    args: tuple[Path, int, int, list[int], bool],
│     254→) -> tuple[
│     255→    list[typ.Scalar],
│     256→    list[typ.Vector3D],
│     257→    list[typ.Vector3D],
│     258→    list[typ.Arr_Nucleotide_15],
│     259→]:
│     260→    """Wrapper for reading a trajectory file."""
│     261→    file_path, start, end, strand_lengths, is_3p_5p = args
