│       6→import mindspore as ms
│       7→import mindspore.numpy as mnp
│       8→from mindspore import ops
│       9→import numpy as np
│      10→
│      11→import jax_dna.utils.types as typ
│      12→
│      13→
│      14→def principal_axes_to_euler_angles(
│      15→    x: typ.Arr_Nucleotide_3,
│      16→    y: typ.Arr_Nucleotide_3,
│      17→    z: typ.Arr_Nucleotide_3,
│      18→) -> tuple[typ.Arr_Nucleotide, typ.Arr_Nucleotide, typ.Arr_Nucleotide]:
│      19→    """Convert principal axes to Tait-Bryan Euler angles.
│      20→
│      21→    A utility function for converting a set of principal axes
│      22→    (that define a rotation matrix) to a commonly used set of
│      23→    Tait-Bryan Euler angles.
│      24→
│      25→    There are two options to compute the Tait-Bryan angles. Each can be seen at the respective links:
│      26→    (1) From wikipedia (under Tait-Bryan angles): https://en.wikipedia.org/wiki/Euler_angles
│      27→    (2) Equation 10A-C: https://danceswithcode.net/engineeringnotes/rotations_in_3d/rotations_in_3d_part1.html
│      28→
│      29→    However, note that the definition from Wikipedia (i.e. the one using arcsin) has numerical stability issues,
│      30→    so we use the definition from (2) (i.e. the one using arctan2)
│      31→
│      32→    Note that if we were following (1), we would do:
│      33→    psi = onp.arcsin(x[1] / onp.sqrt(1 - x[2]**2))
│      34→    theta = onp.arcsin(-x[2])
│      35→    phi = onp.arcsin(y[2] / onp.sqrt(1 - x[2]**2))
│      36→
│      37→    Note that Tait-Bryan (i.e. Cardan) angles are *not* proper euler angles
│      38→    """
│      39→    psi = np.arctan2(x[:, 1], x[:, 0])
│      40→    theta = np.arcsin(-np.clip(x[:, 2], -1, 1))
│      41→    phi = np.arctan2(y[:, 2], z[:, 2])
│      42→
│      43→    return (psi, theta, phi)
│      44→
│      45→
│      46→def euler_angles_to_quaternion(
│      47→    psi: typ.Arr_Nucleotide,
│      48→    theta: typ.Arr_Nucleotide,
│      49→    phi: typ.Arr_Nucleotide,
│      50→) -> typ.Arr_Nucleotide_4:
│      51→    """Convert Euler angles to quaternions.
│      52→
│      53→    A utility function for converting euler angles to quaternions.
│      54→    Used when converting a trajectory DataFrame to a set of states.
│      55→
│      56→    We follow the ZYX convention. For details, see page A-11 in
│      57→    https://ntrs.nasa.gov/api/citations/19770024290/downloads/19770024290.pdf
│      58→    from the following set of documentation:
│      59→    https://ntrs.nasa.gov/citations/19770024290
│      60→    """
│      61→    sin_psi, cos_psi = np.sin(0.5 * psi), np.cos(0.5 * psi)
│      62→    sin_theta, cos_theta = np.sin(0.5 * theta), np.cos(0.5 * theta)
│      63→    sin_phi, cos_phi = np.sin(0.5 * phi), np.cos(0.5 * phi)
│      64→
│      65→    q0 = sin_psi * sin_theta * sin_phi + cos_psi * cos_theta * cos_phi
│      66→    q1 = -sin_psi * sin_theta * cos_phi + sin_phi * cos_psi * cos_theta
│      67→    q2 = sin_psi * cos_theta * sin_phi + cos_psi * sin_theta * cos_phi
│      68→    q3 = sin_psi * cos_theta * cos_phi - cos_psi * sin_theta * sin_phi
│      69→
│      70→    return np.array([q0, q1, q2, q3]).T
│      71→
│      72→
│      73→def smooth_abs(x: typ.ARR_OR_SCALAR, eps: typ.Scalar = 1e-10) -> typ.ARR_OR_SCALAR:
│      74→    """A smooth absolute value function.
│      75→
│      76→    Note that a non-zero eps gives continuous first dervatives.
│      77→
│      78→    https://math.stackexchange.com/questions/1172472/differentiable-approximation-of-the-absolute-value-function
│      79→    """
│      80→    return mnp.sqrt(x**2 + eps)
│      81→
│      82→
│      83→def clamp(x: typ.ARR_OR_SCALAR, lo: typ.Scalar = -1.0, hi: typ.Scalar = 1.0) -> typ.ARR_OR_SCALAR:
│      84→    """Clamp a value between two values."""
│      85→    clipped_max = mnp.where(x >= hi, hi, x)
│      86→    return mnp.where(clipped_max <= lo, lo, clipped_max)
│      87→
│      88→
│      89→# This is an idea to prototype a function that we ca use to benchmark different
