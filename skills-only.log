│      60→        data (dict): The nested dictionary representing the TOML content.
│      61→        prefix (str): The prefix to add to the leaf keys.
│      62→
│      63→    Returns:
│      64→        dict: A new dictionary with updated keys.
│      65→    """
│      66→    if isinstance(data, dict):
│      67→        # Traverse the dictionary and process each key and value
│      68→        return {
│      69→            (prefix + key if not isinstance(value, (dict, list)) else key): add_prefix_to_leaf_keys(value, prefix)
│      70→            for key, value in data.items()
│      71→        }
│      72→
│      73→    if isinstance(data, list):
│      74→        # Process each item in the list
│      75→        return [add_prefix_to_leaf_keys(item, prefix) for item in data]
│      76→
│      77→    # Return data as-is (not a dict or list)
│      78→    return data
│      79→
│      80→
│      81→def merge_dicts(dict1, dict2):
│      82→    """
│      83→    Recursively merge two dictionaries. If a key exists in both:
│      84→    - If the values are dictionaries, merge them recursively.
│      85→    - Otherwise, the value from dict2 overwrites dict1.
│      86→
│      87→    Args:
│      88→        dict1 (dict): The first dictionary.
│      89→        dict2 (dict): The second dictionary.
│      90→
│      91→    Returns:
│      92→        dict: A new dictionary with merged contents.
│      93→    """
│      94→    merged = dict1.copy()  # Start with a copy of dict1
│      95→    for key, value in dict2.items():
│      96→        if key in merged:
│      97→            if isinstance(merged[key], dict) and isinstance(value, dict):
│      98→                # Recursively merge dictionaries
│      99→                merged[key] = merge_dicts(merged[key], value)
│     100→            else:
│     101→                # Overwrite or combine values if not dictionaries
│     102→                merged[key] = value
│     103→        else:
│     104→            # Key is only in dict2
│     105→            merged[key] = value
│     106→    return merged
│     107→
