│      24→def local_helical_axis(quartet: jnp.ndarray, base_sites: jnp.ndarray, displacement_fn: Callable) -> jnp.ndarray:
│      25→    """Computes the normalized local helical axis defined by two base pairs."""
│      26→    # Extract the two base pairs. a1 is h-bonded to b1, a2 is h-bonded to b2
│      27→    bp1, bp2 = quartet
│      28→    (a1, b1), (a2, b2) = bp1, bp2
│      29→
│      30→    # Compute the midpoints of each base pair
│      31→    midp_a1b1 = (base_sites[a1] + base_sites[b1]) / 2.0
│      32→    midp_a2b2 = (base_sites[a2] + base_sites[b2]) / 2.0
│      33→
│      34→    # Compute the normalized direction between the midpoints
│      35→    dr = displacement_fn(midp_a2b2, midp_a1b1)
│      36→    return dr / jnp.linalg.norm(dr)
│      37→
│      38→
│      39→def get_duplex_quartets(n_nucs_per_strand: int) -> jnp.ndarray:
│      40→    """Computes all quartets (i.e. pairs of adjacent base pairs) for a duplex of a given size.
│      41→
│      42→    Args:
│      43→        n_nucs_per_strand (int): number of nucleotides on each strand
│      44→
│      45→    Returns:
│      46→        jnp.ndarray: array of all quartets
│      47→    """
│      48→    # Construct the indices of the nucleotides on each strand
│      49→    s1_nucs = list(range(n_nucs_per_strand))
│      50→    s2_nucs = list(range(n_nucs_per_strand, n_nucs_per_strand * 2))
│      51→    s2_nucs.reverse()
│      52→
│      53→    # Record all pairs of adjacent base pairs
│      54→    bps = list(zip(s1_nucs, s2_nucs, strict=True))
│      55→    all_quartets = list(map(list, itertools.pairwise(bps)))
│      56→
│      57→    return jnp.array(all_quartets, dtype=jnp.int32)
