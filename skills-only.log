│     184→def dseq_to_pseq(dseq: typ.Discrete_Sequence, sc: SequenceConstraints) -> typ.Probabilistic_Sequence:
│     185→    """Converts a discrete sequence to a probabilistic sequence."""
│     186→    # First, generate unpaired pseq
