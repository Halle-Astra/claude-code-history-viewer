│     138→def _determine_oxdna_format(first_line: str) -> tuple[typ.oxDNAFormat, Callable[[list[str]], Topology]]:
│     139→    """Determine the format of an oxDNA file from the first line of the file."""
│     140→    tokens = first_line.strip().split()
│     141→
│     142→    if len(tokens) == N_1ST_LINE_OXDNA_CLASSIC:
│     143→        fmt = typ.oxDNAFormat.CLASSIC
│     144→        func = _from_file_oxdna_classic
│     145→    elif len(tokens) == N_1ST_LINE_OXDNA_NEW:
│     146→        fmt = typ.oxDNAFormat.NEW
│     147→        func = _from_file_oxdna_new
│     148→    else:
