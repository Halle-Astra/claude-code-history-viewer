│     195→@chex.dataclass(frozen=True)
│     196→class Stacking(je_base.BaseEnergyFunction):
│     197→    """Stacking energy function for DNA1 model."""
│     198→
│     199→    params: StackingConfiguration
│     200→
│     201→    @override
│     202→    def __call__(
│     203→        self,
│     204→        body: na1_nucleotide.HybridNucleotide,
│     205→        seq: typ.Discrete_Sequence,
│     206→        bonded_neighbors: typ.Arr_Bonded_Neighbors_2,
│     207→        unbonded_neighbors: typ.Arr_Unbonded_Neighbors_2,
│     208→    ) -> typ.Scalar:
│     209→        nn_i = bonded_neighbors[:, 0]
│     210→        nn_j = bonded_neighbors[:, 1]
│     211→
│     212→        is_rna_bond = jax.vmap(je_utils.is_rna_pair, (0, 0, None))(nn_i, nn_j, self.params.nt_type)
│     213→
│     214→        dna_dgs = dna2_energy.Stacking(
│     215→            displacement_fn=self.displacement_fn, params=self.params.dna_config
│     216→        ).pairwise_energies(
│     217→            body.dna,
│     218→            seq,
│     219→            bonded_neighbors,
│     220→        )
│     221→
│     222→        rna_dgs = rna2_energy.Stacking(
│     223→            displacement_fn=self.displacement_fn, params=self.params.rna_config
│     224→        ).pairwise_energies(
│     225→            body.rna,
│     226→            seq,
│     227→            bonded_neighbors,
│     228→        )
│     229→
│     230→        # Select based on bond type
│     231→        dgs = jnp.where(is_rna_bond, rna_dgs, dna_dgs)
│     232→        return dgs.sum()
