│     226→                    boundaries[:-1],
│     227→                    boundaries[1:],
│     228→                    itertools.repeat(strand_lengths, times=n_runs),
│     229→                    itertools.repeat(is_oxdna, times=n_runs),
│     230→                    strict=True,
│     231→                ),
│     232→            ),
│     233→        )
