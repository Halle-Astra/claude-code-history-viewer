│     264→
│     265→def _read_file(
│     266→    file_path: Path,
│     267→    start: int,
│     268→    end: int,
│     269→    strand_lengths: list[int],
│     270→    *,
│     271→    is_3p_5p: bool,
│     272→) -> tuple[
│     273→    list[typ.Scalar],
│     274→    list[typ.Vector3D],
│     275→    list[typ.Vector3D],
│     276→    list[typ.Arr_Nucleotide_15],
│     277→]:
│     278→    """Read a trajectory file object."""
│     279→    # we don't know where we are in the file, but we can be only in one of two
│     280→    # situations: We are at the start of the state or we are in the midle of a
│     281→    # state. If we are in the middle of a state, we need to read until the next
│     282→    # state starts and then parse the states from there. Importantly, we need
│     283→    # to pass our 'end' if the end is in the middle of a state, because the
│     284→    # worker ahead of in the file will not read it.
│     285→    parse_str = functools.partial(np.fromstring, sep=" ", dtype=np.float64)
│     286→
│     287→    state_length = sum(strand_lengths)
│     288→    strand_bounds = list(itertools.pairwise([0, *itertools.accumulate(strand_lengths)]))
│     289→
│     290→    file_obj = file_path.open()
│     291→    file_obj.seek(start)
│     292→
│     293→    line = file_obj.readline()
│     294→    while not line.startswith("t"):
│     295→        line = file_obj.readline()
│     296→
│     297→    ts, bs, es, states = [], [], [], []
│     298→    state = []
│     299→    current = file_obj.tell()
│     300→    while current < end:
│     301→        if line[0] == "t":
│     302→            t = float(line.strip().split("=")[1])
│     303→            ts.append(t)
│     304→        elif line[0] == "b":
│     305→            b = parse_str(line.strip().split("=")[1])
│     306→            bs.append(b)
│     307→        elif line[0] == "E":
│     308→            e = parse_str(line.strip().split("=")[1])
│     309→            es.append(e)
│     310→        else:
│     311→            state.append(parse_str(line.strip()))
│     312→            if len(state) == state_length:
│     313→                # if the trajectory is stored in 3'->5' order, we need to flip
│     314→                # the order of the nucleotides in each strand
│     315→                if is_3p_5p:
│     316→                    state = list(itertools.chain.from_iterable([state[s:e][::-1] for s, e in strand_bounds]))
│     317→                    state = np.array(state, dtype=np.float64)
│     318→                states.append(np.array(state, dtype=np.float64))
│     319→                state = []
│     320→                current = file_obj.tell()
│     321→
│     322→        line = file_obj.readline()
│     323→
│     324→    return ts, bs, es, states
│     325→
