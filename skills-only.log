[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "jax-dna"
version = "0.2.1"
description = "A framework for designing DNA nanostructures using JAX-based sequence optimization via gradient descent"
readme = "README.md"
requires-python = ">=3.9"
license = {file = "LICENSE"}
authors = [
    {name = "Ryan Hausen", email = "ryan.hausen@ssec.wisc.edu"},
]
keywords = [
    "oxDNA",
    "DNA",
    "RNA",
    "nanostructures",
    "sequence design",
    "optimization",
