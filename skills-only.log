│      27→    else:
│      28→        # taken from https://docs.python.org/3/library/itertools.html#itertools.batched
│      29→        def batch_f(iterable: Iterable[Any], n: int) -> Iterable[Any]:
│      30→            # batched('ABCDEFG', 3) → ABC DEF G
│      31→            if n < 1:
