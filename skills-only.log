    "build>=1.2.2.post1",
    "interrogate>=1.7.0",
    "pre-commit>=4.0.1",
    "pytest-cov>=6.0.0",
    "pytest>=8.3.4",
    "ruff>=0.8.2",
    "tox>=4.23.2",
]
