│     210→    fit_ = mnp.linalg.lstsq(torques_, extensions)
│     211→    a3 = fit_[0][1]
│     212→
│     213→    # Fit a line to the twists
│     214→    fit_ = mnp.linalg.lstsq(torques_, twists)
│     215→    a4 = fit_[0][1]
│     216→
│     217→    return a3, a4
