│      11→    return (jnp.exp(2 * x) + 1) / (jnp.exp(2 * x) - 1)
│      12→
│      13→
│      14→def calculate_extension(
│      15→    force: jd_types.ARR_OR_SCALAR,
│      16→    l0: jd_types.ARR_OR_SCALAR,
│      17→    lp: jd_types.ARR_OR_SCALAR,
│      18→    k: jd_types.ARR_OR_SCALAR,
│      19→    kT: float,  # noqa: N803 -- kT is a special unit variable
│      20→) -> jd_types.ARR_OR_SCALAR:
│      21→    r"""Computes the extension under a specified force under the wormlike chain (WLC) model.
│      22→
│      23→    Via the model of Odijk, the extension of an extensible wormlike chain (WLC) under a force
│      24→    F can be computed as
│      25→
│      26→    .. math::
│      27→      x = L_0 \left (1 + \frac{F}{K} - \frac{kT}{2F} [1 + y\coth y] \right)
│      28→
│      29→    where
│      30→
│      31→    .. math::
│      32→      y = \left( \frac{FL_0^2}{L_p kT} \right)^{1/2}
│      33→
│      34→    where `L_0` is the contour length and `L_p` is the persistence length.
│      35→    This function computes implements this model for computing the extension.
│      36→
│      37→    Args:
│      38→        force (jd_types.ARR_OR_SCALAR): the force applied to the duplex
│      39→        l0 (jd_types.ARR_OR_SCALAR): the contour length
│      40→        lp (jd_types.ARR_OR_SCALAR): the persistence length
│      41→        k (jd_types.ARR_OR_SCALAR): the extensional modulus
│      42→        kT (float): the temperature
│      43→
│      44→    Returns:
│      45→        jd_types.ARR_OR_SCALAR: the predicted extension
│      46→    """
│      47→    y = ((force * l0**2) / (lp * kT)) ** (1 / 2)
│      48→    return l0 * (1 + force / k - kT / (2 * force * l0) * (1 + y * coth(y)))
│      49→
│      50→
│      51→def loss(
│      52→    coeffs: jnp.ndarray,
│      53→    extensions: jnp.ndarray,
│      54→    forces: jnp.ndarray,
│      55→    kT: float,  # noqa: N803 -- kT is a special unit variable
│      56→) -> jnp.ndarray:
│      57→    """An objective function for the WLC model compatible with JAX solvers.
│      58→
│      59→    Args:
│      60→        coeffs (jnp.ndarray): The parameters of the WLC model, ordered as [L_0, L_p, K]
│      61→        extensions (jnp.ndarray): The measured extensions (via simulation) to which we are fitting the model
│      62→        forces (jnp.ndarray): The forces under which the extensions were measured
│      63→        kT (float): the temperature
│      64→
│      65→    Returns:
│      66→        jnp.ndarray: the residual for each measured extension
│      67→    """
│      68→    # Extract the coefficients
│      69→    # Note: coefficients ordering: [L0, Lp, K]
│      70→    l0 = coeffs[0]
│      71→    lp = coeffs[1]
│      72→    k = coeffs[2]
│      73→
│      74→    # Compute the extensions as predicted with the designated parameters
│      75→    extensions_calc = calculate_extension(forces, l0, lp, k, kT)
│      76→
│      77→    # Compute the residuals with the measured extensions
│      78→    return extensions - extensions_calc
│      79→
│      80→
│      81→def fit_wlc(
│      82→    extensions: jnp.ndarray,
│      83→    forces: jnp.ndarray,
│      84→    init_guess: jnp.ndarray,
│      85→    kT: float,  # noqa: N803 -- kT is a special unit variable
│      86→    *,
│      87→    implicit_diff: bool = True,
│      88→) -> jnp.ndarray:
│      89→    """Fit the WLC model via nonlinear least squares given a set of forces and measured extensions.
│      90→
│      91→    Args:
│      92→        extensions (jnp.ndarray): The measured extensions (via simulation) to which we are fitting the model
│      93→        forces (jnp.ndarray): The forces under which the extensions were measured
│      94→        init_guess (jnp.ndarray): An initial guess for the parameters of the WLC model, ordered as [L_0, L_p, K]
│      95→        kT (float): the temperature
│      96→        implicit_diff (bool): Whether or not to use implicit differentiation for the numerical solver
│      97→
│      98→    Returns:
│      99→        jnp.ndarray: the fit parameters of the WLC model, ordered as [L_0, L_p, K]
│     100→    """
│     101→    gn = GaussNewton(residual_fun=loss, implicit_diff=implicit_diff)
│     102→    res = gn.run(init_guess, extensions=extensions, forces=forces, kT=kT)
│     103→    return res.params
│     104→
