│     313→
│     314→def update_params(src_h: Path, new_params: list[jd_types.Params]) -> None:
│     315→    """Update the src/model.h file with the new parameters."""
│     316→    params = read_src_h(src_h)
│     317→    flattened_params = functools.reduce(operator.or_, new_params, {})
│     318→    for np in filter(lambda k: k in DEFAULT_OXDNA_VARIABLE_MAPPER, flattened_params):
│     319→        mapped_name = DEFAULT_OXDNA_VARIABLE_MAPPER[np]
