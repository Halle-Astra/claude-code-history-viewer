│     153→
│     154→def _get_bonded_neighbors(
│     155→    strand_lengths: list[int],
│     156→    is_circular: list[bool],
│     157→) -> list[tuple[int, int]]:
│     158→    """Convert 5' neighbors to bonded neighbors by index."""
│     159→    if len(strand_lengths) != len(is_circular):
│     160→        raise ValueError(ERR_STRAND_COUNTS_CIRCULAR_MISMATCH)
│     161→
│     162→    bonded_neighbors = []
│     163→    init_idx = 0
│     164→    for i, length in enumerate(strand_lengths):
│     165→        pairs = list(itertools.pairwise(range(init_idx, init_idx + length)))
│     166→        if is_circular[i]:
│     167→            # the ordering here in intentional
│     168→            pairs.append((init_idx, init_idx + length - 1))
│     169→        bonded_neighbors.extend(pairs)
│     170→        init_idx += length
│     171→    return bonded_neighbors
│     172→
│     173→
│     174→def _get_unbonded_neighbors(n_nucleotides: int, bonded_neighbors: list[tuple[int, int]]) -> list[tuple[int, int]]:
│     175→    """Get unbonded neighbors."""
│     176→    all_possible_pairs = set(itertools.combinations(range(n_nucleotides), 2))
│     177→    self_bonds = {(i, i) for i in range(n_nucleotides)}
│     178→    return list(all_possible_pairs - set(bonded_neighbors) - self_bonds)
│     179→
│     180→
│     181→def _from_file_oxdna_classic(lines: list[str]) -> Topology:
│     182→    """Read topology information from a file in the classix oxDNA format.
│     183→
│     184→    See https://lorenzo-rovigatti.github.io/oxDNA/configurations.html#topology-file
│     185→    for more information.
│     186→
│     187→    Args:
│     188→        lines (List[str]): lines from topology file
│     189→
│     190→    Returns:
│     191→        Topology: Topology object
│     192→
│     193→    """
│     194→    n_nucleotides, n_strands = list(map(int, lines[0].strip().split()))
│     195→
│     196→    # after the first line the topology files are space delimited with the
│     197→    # following columns:
│     198→    # - strand id (1 indexed)
│     199→    # - nucleotide base (A=0, C=1, G=2, T=3, U=3), use char for now
│     200→    # - 3' neighbor (0-indexed), -1 if none, -1 indicates the stand isn't circular
│     201→    # - 5' neighbor (0-indexed), -1 if none
│     202→    #
│     203→    # A more common convention is to store the nucleotides in the 5' -> 3' direction
│     204→    # so we need to reverse the order, which seems to be as easy as reversing the
│     205→    # order of the nucleotides per strand.
│     206→
│     207→    strand_ids, bases, _, neighbor_5p = list(zip(*[line.strip().split() for line in lines[1:]], strict=True))
│     208→    strand_ids = list(map(int, strand_ids))
│     209→    _, strand_counts = np.unique(strand_ids, return_counts=True)
│     210→    neighbor_5p = list(map(int, neighbor_5p))
│     211→
│     212→    reversed_bases = []
│     213→    is_circular = []
│     214→    is_end = []
│     215→    nt_type = []
│     216→    for i in range(1, n_strands + 1):
│     217→        strand_bases, strand_5p = zip(
│     218→            *[
│     219→                id_nucleotide[1:]
│     220→                for id_nucleotide in zip(strand_ids, bases, neighbor_5p, strict=True)
│     221→                if id_nucleotide[0] == i
│     222→            ],
│     223→            strict=True,
│     224→        )
│     225→        strand_is_circular = strand_5p[-1] != -1
│     226→        is_circular.append(strand_is_circular)
│     227→        reversed_bases.extend(strand_bases[::-1])
│     228→
│     229→        strand_length = len(strand_bases)
│     230→        strand_is_end = [0 for _ in range(strand_length)]
│     231→        if not strand_is_circular:
│     232→            strand_is_end[0] = 1
│     233→            strand_is_end[-1] = 1
│     234→        is_end.extend(strand_is_end)
│     235→
│     236→        # Classic format doesn't permit type specification
│     237→        if "T" in strand_bases:
│     238→            nt_type.extend([NucleotideType.DNA] * strand_length)
│     239→        elif "U" in strand_bases:
│     240→            nt_type.extend([NucleotideType.RNA] * strand_length)
│     241→        else:
│     242→            warnings.warn(WARN_CLASSIC_UNSPECIFIED_NT_TYPE.format(strand_idx=i), stacklevel=1)
│     243→            nt_type.extend([NucleotideType.UNSPECIFIED] * strand_length)
│     244→
│     245→    sequence = "".join(reversed_bases)
│     246→
│     247→    bonded_neighbors = _get_bonded_neighbors(strand_counts, is_circular)
│     248→
│     249→    unbonded_neighbors = _get_unbonded_neighbors(n_nucleotides, bonded_neighbors)
│     250→
│     251→    return Topology(
│     252→        n_nucleotides=n_nucleotides,
│     253→        strand_counts=strand_counts,
│     254→        bonded_neighbors=np.array(list(bonded_neighbors)),
│     255→        unbonded_neighbors=np.array(list(unbonded_neighbors)),
│     256→        seq=jnp.array([jd_const.NUCLEOTIDES_IDX[s] for s in sequence], dtype=jnp.int32),
│     257→        is_end=jnp.array(is_end).astype(jnp.int32),
│     258→        nt_type=jnp.array(nt_type).astype(jnp.int32),
│     259→    )
│     260→
│     261→
│     262→def _from_file_oxdna_new(lines: list[str]) -> Topology:
│     263→    # the first line of the new oxDNA format is:
│     264→    # n_nucleotides n_strands 5->3
│     265→    # we don't need the 5->3, so we'll just ignore it
│     266→    n_nucleotides, n_strands = list(map(int, lines[0].strip().split()[:-1]))
│     267→
│     268→    # the rest of the new oxDNA file format is laid out as follows:
│     269→    # nucleotides k=v
│     270→    # ...
│     271→    # nucleotides k=v
│     272→    # Where `nuclotides` is a string of ACTG and `k=v` is a set of key value pairs
│     273→    # the lines are repeated n_stand times
│     274→
│     275→    sequence = []
│     276→    strand_counts = []
│     277→    is_circular = []
│     278→    is_end = []
│     279→    nt_type = []
│     280→    for line in lines[1:]:
│     281→        nucleotides = line.strip().split()[0]
│     282→        sequence.append(nucleotides)
│     283→        strand_counts.append(len(nucleotides))
│     284→        strand_is_circular = "circular=true" in line
│     285→        is_circular.append(strand_is_circular)
│     286→
│     287→        strand_length = len(nucleotides)
│     288→        strand_is_end = [0 for _ in range(strand_length)]
│     289→        if not strand_is_circular:
│     290→            strand_is_end[0] = 1
│     291→            strand_is_end[-1] = 1
│     292→        is_end.extend(strand_is_end)
│     293→
│     294→        strand_is_dna = "type=DNA" in line
│     295→        strand_is_rna = "type=RNA" in line
│     296→        if strand_is_dna:
│     297→            strand_nt_type = [NucleotideType.DNA] * strand_length
│     298→        elif strand_is_rna:
│     299→            strand_nt_type = [NucleotideType.RNA] * strand_length
│     300→        else:
│     301→            warnings.warn(WARN_NEW_UNSPECIFIED_NT_TYPE.format(strand_idx=line), stacklevel=1)
│     302→            strand_nt_type = [NucleotideType.UNSPECIFIED] * strand_length
│     303→        nt_type.extend(strand_nt_type)
│     304→
│     305→    sequence = "".join(sequence)
│     306→
│     307→    bonded_neighbors = _get_bonded_neighbors(strand_counts, is_circular)
│     308→    unbonded_neighbors = _get_unbonded_neighbors(n_nucleotides, bonded_neighbors)
│     309→
│     310→    return Topology(
│     311→        n_nucleotides=n_nucleotides,
│     312→        strand_counts=np.array(strand_counts),
│     313→        bonded_neighbors=np.array(bonded_neighbors),
│     314→        unbonded_neighbors=np.array(unbonded_neighbors),
│     315→        seq=jnp.array([jd_const.NUCLEOTIDES_IDX[s] for s in sequence], dtype=jnp.int32),
│     316→        is_end=jnp.array(is_end).astype(jnp.int32),
│     317→        nt_type=jnp.array(nt_type).astype(jnp.int32),
│     318→    )
│     319→
