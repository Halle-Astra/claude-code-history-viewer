│     270→
│     271→def _read_file(
│     272→    file_path: Path,
│     273→    start: int,
│     274→    end: int,
│     275→    strand_lengths: list[int],
│     276→    *,
│     277→    is_3p_5p: bool,
│     278→) -> tuple[
│     279→    list[typ.Scalar],
│     280→    list[typ.Vector3D],
│     281→    list[typ.Vector3D],
│     282→    list[typ.Arr_Nucleotide_15],
