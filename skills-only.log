│     136→def stretch(forces: jnp.ndarray, extensions: jnp.ndarray) -> tuple[float, float, float]:
│     137→    r"""Computes the effective stretch modulus and relevant summary statistics from stretch experiments.
│     138→
│     139→    Following Assenza and Perez (JCTC 2022), the effective stretch modulus can be computed as
│     140→
│     141→    .. math::
│     142→      \tilde{S} = \frac{L_0}{A_1}
│     143→
│     144→    where `A_1` and `L_0` are the slope and offset, respectively, of a linear force-extension fit.
│     145→
│     146→    Args:
│     147→        forces (jnp.ndarray): the forces applied to the polymer
│     148→        extensions (jnp.ndarray): the equilibrium extensions under the applied forces
│     149→
│     150→    Returns:
│     151→        Tuple[float, float, float]: the slope and offset of the linear fit, and the effective stretch modulus
│     152→    """
│     153→    # Format the forces for line-fitting
│     154→    forces_ = jnp.stack([jnp.ones_like(forces), forces], axis=1)
│     155→
│     156→    # Fit a line
│     157→    # Note: we do not fix l0 to be the extension under 0 force. We fit it as a parameter.
│     158→    fit_ = jnp.linalg.lstsq(forces_, extensions)
│     159→
│     160→    # Extract statistics
│     161→    a1 = fit_[0][1]
│     162→    l0 = fit_[0][0]  # Note: this is the equilibrium extension at 0 force and torque, *not* the contour length
│     163→
│     164→    # Compute effective stretch modulus
│     165→    s_eff = l0 / a1
│     166→    return a1, l0, s_eff
│     167→
│     168→
│     169→def torsion(torques: jnp.ndarray, extensions: jnp.ndarray, twists: jnp.ndarray) -> tuple[float, float]:
│     170→    """Computes the relevant summary statistics from torsion experiments.
│     171→
│     172→    Following Assenza and Perez (JCTC 2022), the torsional modulus and twist-stretch coupling can be
│     173→    computed via linear fits to the extension and twist of a duplex under torque (when combined with
│     174→    similar statistics from stretching experiments). This function computes the slopes of these
│     175→    linear fits
│     176→
│     177→    Args:
│     178→        torques (jnp.ndarray): the torques applied to the polymer
│     179→        extensions (jnp.ndarray): the equilibrium extensions under the applied torques
│     180→        twists (jnp.ndarray): the equilibrium twists under the applied torques
│     181→
│     182→    Returns:
│     183→        Tuple[float, float]: the slopes of the linear fits to the extensions and twists, respectively
│     184→    """
│     185→    # Format the torques for line-fitting
│     186→    torques_ = jnp.stack([jnp.ones_like(torques), torques], axis=1)
│     187→
│     188→    # Fit a line to the extensions
│     189→    fit_ = jnp.linalg.lstsq(torques_, extensions)
│     190→    a3 = fit_[0][1]
│     191→
│     192→    # Fit a line to the twists
│     193→    fit_ = jnp.linalg.lstsq(torques_, twists)
│     194→    a4 = fit_[0][1]
│     195→
│     196→    return a3, a4
│     197→
│     198→
│     199→def stretch_torsion(
│     200→    forces: jnp.ndarray,
│     201→    force_extensions: jnp.ndarray,
│     202→    torques: jnp.ndarray,
│     203→    torque_extensions: jnp.ndarray,
│     204→    torque_twists: jnp.ndarray,
│     205→) -> tuple[float, float, float]:
│     206→    """Computes the effective stretch and torsion moduli, and twist-stretch coupling from stretch-torsion experiments.
│     207→
│     208→    Args:
│     209→        forces (jnp.ndarray): the forces applied to the polymer
│     210→        force_extensions (jnp.ndarray): the equilibrium extensions under the applied forces
│     211→        torques (jnp.ndarray): the torques applied to the polymer
│     212→        torque_extensions (jnp.ndarray): the equilibrium extensions under the applied torques
│     213→        torque_twists (jnp.ndarray): the equilibrium twists under the applied torques
│     214→
│     215→    Returns:
│     216→        Tuple[float, float, float]: the effective stretch modulus, torsional modulus, and twist-stretch coupling
│     217→    """
│     218→    # Compute the effective stretch modulus and relevant summary statistics from stretching experiments
│     219→    a1, l0, s_eff = stretch(forces, force_extensions)
│     220→
│     221→    # Compute the relevant summary statistics from torsion experiments
│     222→    a3, a4 = torsion(torques, torque_extensions, torque_twists)
│     223→
│     224→    # Compute the torsional modulus and twist-stretch coupling
│     225→    c = a1 * l0 / (a4 * a1 - a3**2)
│     226→    g = -(a3 * l0) / (a4 * a1 - a3**2)
│     227→
│     228→    return s_eff, c, g
