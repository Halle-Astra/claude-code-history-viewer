│      10→
│      11→
│      12→def get_neighbor_list_fn(
│      13→    bonded_neighbors: np.ndarray,
│      14→    n_nucleotides: int,
│      15→    displacement_fn: Callable,
│      16→    box_size: float,
│      17→    r_cutoff: float = 10.0,
│      18→    dr_threshold: float = 0.2,
│      19→) -> Callable:
│      20→    """Construct a neighbor list function for unbonded pairs.
│      21→
│      22→    This function constructs a neighbor list function for identifying neighboring
│      23→    particles that are not bonded. To achieve this, it uses the provided list of
│      24→    bonded neighbors to explicitly exclude bonded pairs from the neighbor list
│      25→    by creating a mask.
│      26→    """
│      27→    bonded_neighbors_in_range = (bonded_neighbors >= 0) & (bonded_neighbors < n_nucleotides)
│      28→    if not bonded_neighbors_in_range.all():
│      29→        raise ValueError(ERR_NEIGHBORS_INVALID_BONDED_NEIGHBORS)
│      30→
│      31→    # Construct nx2 mask specifying bonded pairs
│      32→    dense_mask = np.full((n_nucleotides, 2), n_nucleotides, dtype=np.int32)
│      33→    counter = np.zeros(n_nucleotides, dtype=np.int32)
│      34→    for bp1, bp2 in bonded_neighbors:
│      35→        dense_mask[bp1, counter[bp1]] = bp2
│      36→        counter[bp1] += 1
│      37→
│      38→        dense_mask[bp2, counter[bp2]] = bp1
│      39→        counter[bp2] += 1
│      40→    dense_mask = jnp.array(dense_mask, dtype=jnp.int32)
│      41→
│      42→    # Specify a mask function for the neighbor list construction
│      43→    def bonded_nbrs_mask_fn(dense_idx: np.ndarray) -> np.ndarray:
│      44→        nbr_mask1 = dense_idx == dense_mask[:, 0].reshape(n_nucleotides, 1)
│      45→        dense_idx = jnp.where(nbr_mask1, n_nucleotides, dense_idx)
│      46→
│      47→        nbr_mask2 = dense_idx == dense_mask[:, 1].reshape(n_nucleotides, 1)
│      48→        return jnp.where(nbr_mask2, n_nucleotides, dense_idx)
│      49→
│      50→    # Construct a neighbor list function via JAX-MD
│      51→    return neighbor_list(
│      52→        displacement_fn,
│      53→        box=box_size,
│      54→        r_cutoff=r_cutoff,
│      55→        dr_threshold=dr_threshold,
│      56→        custom_mask_function=bonded_nbrs_mask_fn,
│      57→        format=NeighborListFormat.OrderedSparse,
│      58→        disable_cell_list=True,
│      59→    )
